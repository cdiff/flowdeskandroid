<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F4F6">

    <!-- Header / Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        app:navigationIcon="@drawable/ic_chevron_left"
        app:layout_constraintTop_toTopOf="parent">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="팀원 상세"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_gravity="center" />
    </androidx.appcompat.widget.Toolbar>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:clipToPadding="false">

            <!-- Profile Summary Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded"
                android:padding="24dp"
                android:elevation="2dp"
                android:layout_marginBottom="16dp">

                <!-- Avatar -->
                <ImageView
                    android:id="@+id/iv_avatar"
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:background="@drawable/bg_oval_light_blue"
                    android:src="@drawable/ic_user"
                    android:padding="16dp"
                    app:tint="@color/login_blue"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tv_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    tools:text="슈퍼 관리자"
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginStart="20dp"
                    app:layout_constraintTop_toTopOf="@id/iv_avatar"
                    app:layout_constraintStart_toEndOf="@id/iv_avatar"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tv_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="admin"
                    android:textColor="@color/gray_text"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_name"
                    app:layout_constraintStart_toStartOf="@id/tv_name" />

                <!-- Badges (multiple roles) -->
                <HorizontalScrollView
                    android:id="@+id/hsv_role_badges"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_id"
                    app:layout_constraintStart_toStartOf="@id/tv_name"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:id="@+id/ll_role_badges"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical" />

                </HorizontalScrollView>

                <View
                    android:id="@+id/div_status"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EAEAEA"
                    android:layout_marginTop="24dp"
                    app:layout_constraintTop_toBottomOf="@id/hsv_role_badges" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card_rounded_border"
                    android:padding="7dp"
                    app:layout_constraintTop_toBottomOf="@id/div_status">

                    <View
                        android:id="@+id/v_status_dot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_oval_green"
                        android:layout_marginStart="8dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/tv_status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="활성"
                        android:textColor="@color/black"
                        android:textSize="13sp"
                        android:layout_marginStart="8dp"
                        app:layout_constraintStart_toEndOf="@id/v_status_dot"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_toggle_status"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        tools:text="비활성화"
                        android:textSize="12sp"
                        android:textColor="@color/black"
                        android:background="@drawable/bg_card_rounded_border"
                        android:paddingHorizontal="16dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Basic Info Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded"
                android:padding="24dp"
                android:elevation="2dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tv_basic_info_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="기본 정보"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Edit & Save Actions -->
                <TextView
                    android:id="@+id/btn_edit_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="수정"
                    android:textColor="@color/login_blue"
                    android:textSize="14sp"
                    android:paddingVertical="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_basic_info_title"
                    app:layout_constraintBottom_toBottomOf="@id/tv_basic_info_title" />

                <LinearLayout
                    android:id="@+id/ll_edit_actions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_basic_info_title"
                    app:layout_constraintBottom_toBottomOf="@id/tv_basic_info_title">
                    
                    <TextView
                        android:id="@+id/btn_cancel_edit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="취소"
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="8dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/btn_save_edit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="저장"
                        android:textSize="14sp"
                        android:textColor="@color/login_blue"
                        android:paddingVertical="8dp" />
                </LinearLayout>

                <View
                    android:id="@+id/div_basic"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EAEAEA"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_basic_info_title" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@id/div_basic">

                    <TextView android:text="회사명" android:textSize="12sp" android:textColor="@color/gray_text" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <EditText android:id="@+id/et_info_company" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null" android:textSize="16sp" android:textColor="@color/black" android:layout_marginTop="4dp" android:layout_marginBottom="16dp" android:padding="0dp" android:inputType="text" android:enabled="false"/>

                    <TextView android:text="이름" android:textSize="12sp" android:textColor="@color/gray_text" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <EditText android:id="@+id/et_info_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null" android:textSize="16sp" android:textColor="@color/black" android:layout_marginTop="4dp" android:layout_marginBottom="16dp" android:padding="0dp" android:inputType="text" android:enabled="false"/>

                    <TextView android:text="이메일" android:textSize="12sp" android:textColor="@color/gray_text" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <EditText android:id="@+id/et_info_email" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null" android:textSize="16sp" android:textColor="@color/black" android:layout_marginTop="4dp" android:layout_marginBottom="16dp" android:padding="0dp" android:inputType="textEmailAddress" android:enabled="false"/>

                    <TextView android:text="전화번호" android:textSize="12sp" android:textColor="@color/gray_text" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <EditText android:id="@+id/et_info_tel" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null" android:textSize="16sp" android:textColor="@color/black" android:layout_marginTop="4dp" android:layout_marginBottom="16dp" android:padding="0dp" android:inputType="phone" android:enabled="false"/>

                    <TextView android:text="휴대폰" android:textSize="12sp" android:textColor="@color/gray_text" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <EditText android:id="@+id/et_info_hp" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null" android:textSize="16sp" android:textColor="@color/black" android:layout_marginTop="4dp" android:padding="0dp" android:inputType="phone" android:enabled="false"/>

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Role Management Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded"
                android:padding="24dp"
                android:elevation="2dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tv_role_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="역할 관리"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <View
                    android:id="@+id/div_roles"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EAEAEA"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_role_title" />

                <LinearLayout
                    android:id="@+id/ll_roles_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@id/div_roles">
                    <!-- Dynamic role items go here -->
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_save_roles"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="역할 저장"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_rect_rounded_blue"
                    android:drawableStart="@drawable/ic_shield_check"
                    android:paddingHorizontal="100dp"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@id/ll_roles_container" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Change Password Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded"
                android:padding="24dp"
                android:elevation="2dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tv_pwd_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="비밀번호 변경"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tv_pwd_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="관리자 권한으로 사용자의 비밀번호를 변경합니다"
                    android:textSize="12sp"
                    android:textColor="@color/gray_text"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_pwd_title"
                    app:layout_constraintStart_toStartOf="parent" />

                <View
                    android:id="@+id/div_pwd"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EAEAEA"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_pwd_desc" />

                <TextView
                    android:id="@+id/tv_new_pwd_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="새 비밀번호"
                    android:textSize="12sp"
                    android:textColor="@color/gray_text"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@id/div_pwd"
                    app:layout_constraintStart_toStartOf="parent" />

                <EditText
                    android:id="@+id/et_new_password"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_card_rounded_border"
                    android:hint="6자 이상 입력"
                    android:inputType="textPassword"
                    android:textSize="14dp"
                    android:paddingHorizontal="16dp"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_new_pwd_label" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_change_password"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="비밀번호 변경"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_rect_rounded_blue"
                    android:drawableStart="@drawable/ic_lock"
                    android:paddingHorizontal="100dp"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@id/et_new_password" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Danger Zone Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_danger"
                android:paddingBottom="24dp"
                android:elevation="0dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tv_danger_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="로그아웃"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#CC0000"
                    android:layout_marginTop="15dp"
                    android:layout_marginStart="24dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <View
                    android:id="@+id/div_danger"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#FEE2E2"
                    android:layout_marginTop="15dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_danger_title" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_invalidate_tokens"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="모든 토큰 무효화 (강제 로그아웃)"
                    android:textColor="#EF4444"
                    android:background="@drawable/bg_btn_danger_outline"
                    android:drawableStart="@drawable/ic_logout_red"
                    android:paddingHorizontal="40dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginHorizontal="24dp"
                    app:layout_constraintTop_toBottomOf="@id/div_danger" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Registration Date Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded"
                android:padding="15dp"
                android:elevation="2dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="가입일"
                    android:textColor="@color/gray_text"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/tv_reg_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="2026. 01. 28. 오후 08:11"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Loading Indicator -->
            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginTop="16dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
