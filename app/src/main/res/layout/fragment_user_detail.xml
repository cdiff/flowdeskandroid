<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Header / Toolbar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="@color/white"
        android:elevation="1dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_chevron_left"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#1E293B"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="팀원 상세"
            android:textColor="#1E293B"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- ===== 프로필 요약 및 활성 상태 관리 섹션 ===== -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <!-- 사용자 이름, 상태 배지 및 ID -->
                <LinearLayout
                    android:id="@+id/ll_profile_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tv_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="슈퍼 관리자"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#0F172A" />

                        <!-- 상태 표시 (백그라운드 없음) -->
                        <TextView
                            android:id="@+id/tv_status_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="활성"
                            tools:textColor="@color/green_500"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginStart="8dp" />

                        <!-- 우측 정렬을 위한 Spacer -->
                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <!-- 상태 변경 버튼 (우측 끝) -->
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_toggle_status"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            tools:text="비활성화"
                            android:textSize="11sp"
                            android:textColor="#475569"
                            android:textStyle="bold"
                            android:background="@drawable/bg_card_rounded_border"
                            android:paddingHorizontal="12dp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="admin"
                        android:textColor="#94A3B8"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 역할 배지 목록 -->
            <HorizontalScrollView
                android:id="@+id/hsv_role_badges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:id="@+id/ll_role_badges"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />
            </HorizontalScrollView>

            <!-- 구분선 -->
            <View
                android:id="@+id/div_status"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E2E8F0"
                android:layout_marginBottom="28dp" />

            <!-- ===== 기본 정보 섹션 ===== -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tv_basic_info_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="기본 정보"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />



            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 회사명 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="회사명"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:letterSpacing="0.02" />
                <EditText
                    android:id="@+id/et_info_company"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColorHint="#CBD5E1"
                    android:textColor="#0F172A"
                    android:paddingTop="6dp"
                    android:paddingBottom="10dp"
                    android:inputType="text"
                    android:enabled="true"
                    android:maxLines="1" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8F0" />
            </LinearLayout>

            <!-- 이름 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="이름"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:letterSpacing="0.02" />
                <EditText
                    android:id="@+id/et_info_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColorHint="#CBD5E1"
                    android:textColor="#0F172A"
                    android:paddingTop="6dp"
                    android:paddingBottom="10dp"
                    android:inputType="text"
                    android:enabled="true"
                    android:maxLines="1" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8F0" />
            </LinearLayout>

            <!-- 이메일 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="이메일"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:letterSpacing="0.02" />
                <EditText
                    android:id="@+id/et_info_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColorHint="#CBD5E1"
                    android:textColor="#0F172A"
                    android:paddingTop="6dp"
                    android:paddingBottom="10dp"
                    android:inputType="textEmailAddress"
                    android:enabled="true"
                    android:maxLines="1" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8F0" />
            </LinearLayout>

            <!-- 전화번호 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="전화번호"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:letterSpacing="0.02" />
                <EditText
                    android:id="@+id/et_info_tel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColorHint="#CBD5E1"
                    android:textColor="#0F172A"
                    android:paddingTop="6dp"
                    android:paddingBottom="10dp"
                    android:inputType="phone"
                    android:enabled="true"
                    android:maxLines="1" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8F0" />
            </LinearLayout>

            <!-- 휴대폰 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="28dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="휴대폰"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:letterSpacing="0.02" />
                <EditText
                    android:id="@+id/et_info_hp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColorHint="#CBD5E1"
                    android:textColor="#0F172A"
                    android:paddingTop="6dp"
                    android:paddingBottom="10dp"
                    android:inputType="phone"
                    android:enabled="true"
                    android:maxLines="1" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8F0" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F1F5F9"
                android:layout_marginBottom="28dp" />

            <!-- ===== 역할 관리 섹션 ===== -->
            <TextView
                android:id="@+id/tv_role_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="역할 관리"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:layout_marginBottom="16dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_roles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-4dp"
                android:layout_marginEnd="-4dp"
                android:layout_marginBottom="16dp"
                android:nestedScrollingEnabled="false"
                tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                tools:spanCount="2"
                tools:listitem="@layout/item_role_selection_grid" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_save_roles"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="저장하기"
                android:textColor="@color/white"
                android:background="@drawable/bg_rect_rounded_blue"
                android:paddingHorizontal="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="28dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F1F5F9"
                android:layout_marginBottom="28dp" />

            <!-- ===== 비밀번호 변경 섹션 ===== -->
            <TextView
                android:id="@+id/tv_pwd_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="비밀번호 변경"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:id="@+id/tv_pwd_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="관리자 권한으로 사용자의 비밀번호를 변경합니다"
                android:textSize="12sp"
                android:textColor="#64748B"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tv_new_pwd_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="새 비밀번호"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:letterSpacing="0.02" />

                <EditText
                    android:id="@+id/et_new_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="6자 이상 입력"
                    android:inputType="textPassword"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColorHint="#CBD5E1"
                    android:textColor="#0F172A"
                    android:paddingTop="6dp"
                    android:paddingBottom="10dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8F0" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_change_password"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="비밀번호 변경"
                android:textColor="@color/white"
                android:background="@drawable/bg_rect_rounded_blue"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="28dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F1F5F9"
                android:layout_marginBottom="28dp" />

            <!-- ===== Danger Zone (로그아웃) ===== -->
            <TextView
                android:id="@+id/tv_danger_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="로그아웃"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#EF4444"
                android:layout_marginBottom="16dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_invalidate_tokens"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="모든 토큰 무효화 (강제 로그아웃)"
                android:textColor="#EF4444"
                android:background="@drawable/bg_btn_danger_outline"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="28dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F1F5F9"
                android:layout_marginBottom="28dp" />

            <!-- ===== 가입일 섹션 ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="가입일"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_reg_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="2026. 01. 28. 오후 08:11"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- Loading Indicator -->
            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
