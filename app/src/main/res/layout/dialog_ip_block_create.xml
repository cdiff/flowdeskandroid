<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingTop="16dp">

    <!-- Handle line at top -->
    <View
        android:id="@+id/handle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#E5E5E5"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/btn_close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_close"
        app:tint="@color/gray_text"
        android:layout_marginEnd="20dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_header_title"
        app:layout_constraintBottom_toBottomOf="@id/tv_header_title" />

    <!-- ─── 헤더 타이틀 (아이콘 제거 후 좌측 정렬) ─── -->
    <TextView
        android:id="@+id/tv_header_title"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:text="IP 차단 등록"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/handle" />

    <TextView
        android:id="@+id/tv_header_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="허가되지 않은 악성 트래픽 IP를 차단합니다."
        android:textColor="@color/gray_text"
        android:textSize="14sp"
        android:layout_marginEnd="16dp"
        app:layout_constraintStart_toStartOf="@id/tv_header_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_header_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/tv_header_subtitle"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="20dp">

            <!-- Section: 등록 방식 선택 (슬라이딩 세그먼트 탭 적용) -->
            <LinearLayout
                android:id="@+id/fl_mode_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="등록 방식 *"
                    android:textColor="@color/gray_text"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_segment_container"
                    android:padding="3dp"
                    android:layout_marginBottom="16dp">

                    <!-- 슬라이딩하는 흰색 둥근 배경 뷰 -->
                    <View
                        android:id="@+id/v_segment_selector"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_segment_item_selected" />

                    <!-- 클릭 가능한 탭 텍스트들 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btn_mode_single"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="단일 등록"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#3B82F6"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/btn_mode_bulk"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="대량 등록"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#64748B"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- Section: 단일 IP 입력 -->
            <LinearLayout
                android:id="@+id/ll_single_ip_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="차단할 IP 주소 *"
                    android:textColor="@color/gray_text"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/et_block_ip"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_card_rounded_border"
                    android:hint="예) 192.168.1.100"
                    android:paddingHorizontal="16dp"
                    android:maxLines="1"
                    android:inputType="text"
                    android:fontFamily="monospace"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp" />
            </LinearLayout>

            <!-- Section: 대량 IP 입력 -->
            <LinearLayout
                android:id="@+id/ll_bulk_ip_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="차단할 IP 주소 목록 (줄바꿈 구분) *"
                    android:textColor="@color/gray_text"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/et_block_ips"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:gravity="top"
                    android:background="@drawable/bg_card_rounded_border"
                    android:hint="줄바꿈으로 구분해 여러 IP를 입력하세요.\n예)\n192.168.1.1\n192.168.1.2"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:inputType="textMultiLine"
                    android:fontFamily="monospace"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp" />
            </LinearLayout>

            <!-- Section: 차단 사유 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="차단 사유 *"
                android:textColor="@color/gray_text"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_reason"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:gravity="top"
                android:background="@drawable/bg_card_rounded_border"
                android:hint="IP를 차단하는 사유를 입력해주세요. (예: 악성 트래픽 발생)"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:inputType="textMultiLine"
                android:textSize="14sp"
                android:layout_marginBottom="20dp" />

            <!-- Loading Indicator Container -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">
                <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_gravity="center" />
                <TextView
                    android:id="@+id/tv_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/red"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:visibility="gone" />
            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:background="@color/white"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_create"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="등록하기"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#3B82F6"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:cornerRadius="16dp"
            app:elevation="1dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
