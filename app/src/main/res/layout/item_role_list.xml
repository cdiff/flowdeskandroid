<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_white_rounded_12dp"
    android:paddingHorizontal="16dp"
    android:paddingVertical="16dp"
    android:clickable="true"
    android:focusable="true">

    <!-- 역할 이름 -->
    <TextView
        android:id="@+id/tv_role_display_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        tools:text="슈퍼 관리자"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- 더보기 아이콘 (세로 점 세 개) -->
    <ImageView
        android:id="@+id/iv_more"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_more_vert"
        android:padding="2dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="@color/text_hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_role_display_name"
        app:layout_constraintBottom_toBottomOf="@id/tv_role_display_name" />

    <!-- 설명 -->
    <TextView
        android:id="@+id/tv_role_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="시스템 전체 관리 권한을 가진 최고 관리자"
        android:textColor="@color/gray_text"
        android:textSize="13sp"
        android:layout_marginTop="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_role_display_name"
        app:layout_constraintEnd_toStartOf="@id/iv_more"/>

    <!-- 활성 상태 표시 (텍스트 뱃지 형태) -->
    <TextView
        android:id="@+id/tv_role_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="• 활성"
        android:textColor="@color/color_success_active"
        android:textSize="12sp"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toStartOf="@id/iv_more"
        app:layout_constraintTop_toTopOf="@id/tv_role_display_name"
        app:layout_constraintBottom_toBottomOf="@id/tv_role_display_name"/>

    <!-- 하단 통계 정보 (사용자 수, 권한 수, 생성일) -->
    <LinearLayout
        android:id="@+id/ll_info_counts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_role_description">

        <!-- 사용자 아이콘 -->
        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_user"
            app:tint="@color/text_hint"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/tv_user_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="2명"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <!-- 수직 구분선 1 -->
        <View
            android:layout_width="1dp"
            android:layout_height="10dp"
            android:background="#D1D5DB"
            android:layout_marginHorizontal="8dp" />

        <!-- 권한 아이콘 -->
        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_lock"
            app:tint="@color/text_hint"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/tv_permission_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="50개"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <!-- 수직 구분선 2 -->
        <View
            android:layout_width="1dp"
            android:layout_height="10dp"
            android:background="#D1D5DB"
            android:layout_marginHorizontal="8dp" />

        <TextView
            android:id="@+id/tv_created_at"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="2026.02.17"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- 확장 메뉴 (아코디언 구조) -->
    <LinearLayout
        android:id="@+id/ll_hidden_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/ll_info_counts"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 수정 버튼 -->
        <TextView
            android:id="@+id/btn_manage_permissions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="수정"
            android:textColor="@color/login_blue"
            android:textSize="13sp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

        <!-- 세로 구분선 1 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="|"
            android:textColor="#D1D5DB"
            android:textSize="11sp"
            android:layout_gravity="center_vertical" />

        <!-- 활성화/비활성화 버튼 -->
        <TextView
            android:id="@+id/btn_toggle_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="비활성화"
            android:textColor="@color/gray_text"
            android:textSize="13sp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

        <!-- 세로 구분선 2 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="|"
            android:textColor="#D1D5DB"
            android:textSize="11sp"
            android:layout_gravity="center_vertical" />

        <!-- 삭제 버튼 -->
        <TextView
            android:id="@+id/btn_delete_role"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="삭제"
            android:textColor="@color/red"
            android:textSize="13sp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
