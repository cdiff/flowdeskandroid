<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_white_rounded_12dp"
    android:elevation="0.5dp"
    android:paddingHorizontal="16dp"
    android:paddingVertical="16dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Tenant Name -->
    <TextView
        android:id="@+id/tv_tenant_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="8dp"
        tools:text="삼성전자"
        android:textColor="@color/black"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tv_tenant_status"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Domain -->
    <TextView
        android:id="@+id/tv_tenant_domain"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        tools:text="samsung.flowdesk.com"
        android:textColor="@color/gray_text"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="@id/tv_tenant_name"
        app:layout_constraintEnd_toEndOf="@id/tv_tenant_name"
        app:layout_constraintTop_toBottomOf="@id/tv_tenant_name" />

    <!-- Status Badge -->
    <TextView
        android:id="@+id/tv_tenant_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="활성"
        android:textColor="@color/green_accent"
        android:background="@drawable/bg_tag_light_green"
        android:textSize="11sp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toStartOf="@id/iv_more"
        app:layout_constraintTop_toTopOf="@id/tv_tenant_name"
        app:layout_constraintBottom_toBottomOf="@id/tv_tenant_domain" />

    <!-- More Icon -->
    <ImageView
        android:id="@+id/iv_more"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_chevron_right"
        android:padding="2dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="@color/gray_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_tenant_name"
        app:layout_constraintBottom_toBottomOf="@id/tv_tenant_domain" />

    <!-- Hidden Menu (expand) -->
    <LinearLayout
        android:id="@+id/ll_hidden_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tv_tenant_domain"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 활성화/비활성화 텍스트 버튼 -->
        <TextView
            android:id="@+id/btn_toggle_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="비활성화"
            android:textColor="@color/gray_text"
            android:textSize="13sp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

        <!-- 세로 구분선 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="|"
            android:textColor="#D1D5DB"
            android:textSize="11sp"
            android:layout_gravity="center_vertical" />

        <!-- 삭제 텍스트 버튼 -->
        <TextView
            android:id="@+id/btn_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="삭제"
            android:textColor="@color/red"
            android:textSize="13sp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>
