<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_white_rounded_12dp"
    android:elevation="0.5dp"
    android:paddingHorizontal="16dp"
    android:paddingVertical="16dp"
    android:clickable="true"
    android:focusable="true">

    <!-- 액션 이름 (actionName) -->
    <TextView
        android:id="@+id/tv_action_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="read"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tv_action_status" />

    <!-- 표시 이름 (displayName) -->
    <TextView
        android:id="@+id/tv_action_display_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        tools:text="조회"
        android:textColor="@color/gray_text"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/tv_action_name"
        app:layout_constraintEnd_toEndOf="@id/tv_action_name"
        app:layout_constraintTop_toBottomOf="@id/tv_action_name" />

    <!-- 상태 뱃지 -->
    <TextView
        android:id="@+id/tv_action_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="활성"
        android:textColor="@color/green_accent"
        android:background="@drawable/bg_tag_light_green"
        android:textSize="11sp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toStartOf="@id/iv_more"
        app:layout_constraintTop_toTopOf="@id/tv_action_name"
        app:layout_constraintBottom_toBottomOf="@id/tv_action_display_name" />

    <!-- 더보기 아이콘 (Chevron 우측 화살표로 통일) -->
    <ImageView
        android:id="@+id/iv_more"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_chevron_right"
        android:padding="2dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="@color/gray_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_action_name"
        app:layout_constraintBottom_toBottomOf="@id/tv_action_display_name" />

    <!-- 메타 정보 1줄 요약 행: 연결된 권한 수 -->
    <LinearLayout
        android:id="@+id/ll_info_counts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_action_display_name"
        app:layout_constraintStart_toStartOf="@id/tv_action_name">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="권한 "
            android:textColor="@color/gray_text"
            android:textSize="12sp"/>
        <TextView
            android:id="@+id/tv_action_permission_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="15"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="개"
            android:textColor="@color/gray_text"
            android:textSize="12sp"/>

    </LinearLayout>

    <!-- 히든 메뉴 (더보기 클릭 시 펼쳐짐) -->
    <LinearLayout
        android:id="@+id/ll_hidden_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/ll_info_counts"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 활성화/비활성화 버튼 -->
        <TextView
            android:id="@+id/btn_toggle_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="비활성화"
            android:textColor="@color/gray_text"
            android:textSize="13sp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

        <!-- 세로 구분선 1 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="|"
            android:textColor="#D1D5DB"
            android:textSize="11sp"
            android:layout_gravity="center_vertical" />

        <!-- 삭제 버튼 -->
        <TextView
            android:id="@+id/btn_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="삭제"
            android:textColor="@color/red"
            android:textSize="13sp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
