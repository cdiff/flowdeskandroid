<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_rounded"
    android:orientation="vertical"
    android:padding="16dp"
    android:elevation="1dp"
    android:layout_marginBottom="8dp">

    <!-- 헤더 행: 이름 + 활성 뱃지 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tv_tenant_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="system"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#111827" />

        <TextView
            android:id="@+id/tv_tenant_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="활성"
            android:textSize="11sp"
            android:textColor="@color/green_accent"
            android:background="@drawable/bg_tag_light_green"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <!-- 서브 행: ID / 세션 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ID: "
            android:textSize="12sp"
            android:textColor="@color/gray_text" />

        <TextView
            android:id="@+id/tv_tenant_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="1"
            android:textSize="12sp"
            android:textColor="@color/gray_text" />

        <View
            android:layout_width="1dp"
            android:layout_height="12dp"
            android:background="#D1D5DB"
            android:layout_marginHorizontal="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="세션: "
            android:textSize="12sp"
            android:textColor="@color/gray_text" />

        <TextView
            android:id="@+id/tv_tenant_session"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="16"
            android:textSize="12sp"
            android:textColor="@color/gray_text" />

    </LinearLayout>

    <!-- 통계 박스 그리드 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- 사용자 박스 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_rect_rounded_light_gray"
            android:paddingVertical="10dp"
            android:layout_marginEnd="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="사용자"
                android:textSize="11sp"
                android:textColor="@color/gray_text"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_tenant_users"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="5"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#111827" />
        </LinearLayout>

        <!-- 게시글 박스 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_rect_rounded_light_gray"
            android:paddingVertical="10dp"
            android:layout_marginEnd="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="게시글"
                android:textSize="11sp"
                android:textColor="@color/gray_text"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_tenant_posts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="12"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#111827" />
        </LinearLayout>

        <!-- 역할 박스 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_rect_rounded_light_gray"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="역할"
                android:textSize="11sp"
                android:textColor="@color/gray_text"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_tenant_roles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="2"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#111827" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
