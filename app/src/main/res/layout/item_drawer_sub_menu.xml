<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_drawer_sub_item"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="12dp"
    android:layout_marginVertical="1dp"
    android:background="@drawable/bg_drawer_item_selector"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp">

    <!-- Sub Menu Bullet Indicator -->
    <View
        android:id="@+id/v_bullet"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:background="@drawable/bg_circle_blue"
        android:backgroundTint="#94A3B8" />

    <TextView
        android:id="@+id/tv_sub_menu_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:textColor="#334155"
        android:textSize="14sp"
        android:textStyle="normal"
        android:text="하위 메뉴 이름" />

</LinearLayout>
