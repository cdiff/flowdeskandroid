<?xml version="1.0" encoding="utf-8"?>
<!-- ViewPager2 페이지 규격(match_parent 필수)을 맞추기 위한 루트 FrameLayout -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 실제 카드 UI (중앙 배치) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginVertical="8dp"
        android:clipToOutline="true"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:cardPreventCornerOverlap="true"
        app:cardUseCompatPadding="true"
        app:cardBackgroundColor="@color/white"
        android:foreground="?attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 헤더: 역할명 + 시스템 코드 배지 나란히 배치 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <!-- 역할명 -->
                <TextView
                    android:id="@+id/tv_role_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="마케팅 매니저"
                    android:textColor="#0F172A"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginEnd="8dp"/>

                <!-- 시스템 역할 코드 배지 -->
                <TextView
                    android:id="@+id/tv_role_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="marketing_manager"
                    android:textSize="10sp"
                    android:textColor="@color/login_blue"
                    android:background="@drawable/bg_badge_rounded_blue_border"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1.5dp"
                    android:gravity="center"
                    android:includeFontPadding="false"/>

            </LinearLayout>

            <!-- 구분선 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F1F5F9"
                android:layout_marginBottom="12dp"/>

            <!-- 푸터: 권한 개수 / 역할 사용자 정보 (2줄 구조) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1행: 권한 개수 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="권한 개수"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_permission_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="12개"
                        android:textColor="#0F172A"
                        android:textStyle="bold"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- 2행: 역할 사용자 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="역할 사용자"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_user_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="3명"
                        android:textColor="#0F172A"
                        android:textStyle="bold"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>
