<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingStart="20dp">

    <!-- 자식 여부를 나타내는 가이드라인 (동적 마진용) -->
    <!-- 어댑터에서 깊이(depth)에 따라 start padding/margin을 조절할 예정 -->

    <!-- 펼침/접힘 화살표 (하위 페이지가 있을 때만 표시) -->
    <ImageView
        android:id="@+id/iv_expand"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/gray_text"
        android:visibility="invisible"
        android:layout_marginEnd="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_page_name"
        app:layout_constraintBottom_toBottomOf="@id/tv_page_name" />

    <!-- 페이지 이름 (pageName) -->
    <TextView
        android:id="@+id/tv_page_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="super.dashboard"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        app:layout_constraintStart_toEndOf="@id/iv_expand"
        app:layout_constraintTop_toTopOf="@id/iv_more"
        app:layout_constraintBottom_toBottomOf="@id/iv_more"
        app:layout_constraintEnd_toStartOf="@id/tv_page_status" />

    <!-- 표시 이름 (displayName) -->
    <TextView
        android:id="@+id/tv_page_display_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        tools:text="대시보드"
        android:textColor="@color/gray_text"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/tv_page_name"
        app:layout_constraintEnd_toEndOf="@id/tv_page_name"
        app:layout_constraintTop_toBottomOf="@id/tv_page_name" />

    <!-- 경로 (path) -->
    <TextView
        android:id="@+id/tv_page_path"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        tools:text="/super/dashboard"
        android:textColor="#9CA3AF"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="@id/tv_page_name"
        app:layout_constraintEnd_toEndOf="@id/tv_page_name"
        app:layout_constraintTop_toBottomOf="@id/tv_page_display_name" />

    <!-- 상태 뱃지 -->
    <TextView
        android:id="@+id/tv_page_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="활성"
        android:textColor="@color/green_accent"
        android:background="@drawable/bg_tag_light_green"
        android:textSize="11sp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toStartOf="@id/iv_more"
        app:layout_constraintTop_toTopOf="@id/iv_more"
        app:layout_constraintBottom_toBottomOf="@id/iv_more" />

    <!-- 더보기 아이콘 -->
    <ImageView
        android:id="@+id/iv_more"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_more_vert"
        android:padding="2dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="@color/gray_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 정렬 / 하위 / 권한 정보 칩 행 -->
    <LinearLayout
        android:id="@+id/ll_meta_chips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/tv_page_path"
        app:layout_constraintStart_toStartOf="@id/tv_page_name"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 정렬 순서 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card_rounded_border"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:layout_marginEnd="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="정렬 "
                android:textColor="@color/gray_text"
                android:textSize="11sp"/>
            <TextView
                android:id="@+id/tv_page_order"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="1"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- 하위 페이지 수 (클릭 가능하게 변경) -->
        <LinearLayout
            android:id="@+id/ll_child_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card_rounded_border"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="하위 "
                android:textColor="@color/gray_text"
                android:textSize="11sp"/>
            <TextView
                android:id="@+id/tv_page_child_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="5"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- 연결된 권한 수 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_banner_light_blue"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="권한 "
                android:textColor="@color/login_blue"
                android:textSize="11sp"/>
            <TextView
                android:id="@+id/tv_page_permission_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="4"
                android:textColor="@color/login_blue"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>

    </LinearLayout>

    <!-- 히든 메뉴 (expand) -->
    <LinearLayout
        android:id="@+id/ll_hidden_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/ll_meta_chips"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btn_toggle_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="비활성화"
            android:textColor="@color/login_blue"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingVertical="6dp"
            android:paddingHorizontal="14dp"
            android:background="@drawable/bg_banner_light_blue"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/btn_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="수정"
            android:textColor="@color/gray_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingVertical="6dp"
            android:paddingHorizontal="14dp"
            android:background="@drawable/bg_card_rounded_border"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/btn_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="삭제"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingVertical="6dp"
            android:paddingHorizontal="14dp"
            android:background="@drawable/bg_card_danger"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#4DE5E5E5"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/ll_hidden_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
