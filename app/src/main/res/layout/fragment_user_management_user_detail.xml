<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btn_save_roles"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="8dp">

            <!-- 상단 설명 문구 -->
            <TextView
                android:id="@+id/tv_profile_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/user_management_desc_user_detail"
                android:textColor="@color/slate_500"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginBottom="28dp" />

            <!-- ===== 기본 정보 섹션 ===== -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tv_basic_info_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/user_management_label_basic_info"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/slate_900"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />



            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 사용자 ID (수정 불가) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/user_management_label_user_id"
                    android:textColor="@color/slate_400"
                    android:textSize="12sp"
                    android:letterSpacing="0.02" />
                <TextView
                    android:id="@+id/tv_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="admin"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/slate_400"
                    android:paddingTop="6dp"
                    android:paddingBottom="10dp" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/slate_200" />
            </LinearLayout>



            <!-- 회사명 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/user_management_label_company_name"
                    android:textColor="@color/slate_400"
                    android:textSize="12sp"
                    android:letterSpacing="0.02" />
                <TextView
                    android:id="@+id/tv_info_company"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Flowdesk"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/slate_400"
                    android:paddingTop="6dp"
                    android:paddingBottom="10dp" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/slate_200" />
            </LinearLayout>

            <!-- 이름 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="2dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/user_management_label_name"
                        android:textColor="@color/slate_400"
                        android:textSize="12sp"
                        android:letterSpacing="0.02" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" *"
                        android:textColor="@color/red_500"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <EditText
                    android:id="@+id/et_info_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColorHint="@color/slate_300"
                    android:textColor="@color/slate_900"
                    android:paddingTop="6dp"
                    android:paddingBottom="10dp"
                    android:inputType="text"
                    android:enabled="true"
                    android:maxLines="1" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/slate_200" />
            </LinearLayout>

            <!-- 이메일 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="2dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/user_management_label_email"
                        android:textColor="@color/slate_400"
                        android:textSize="12sp"
                        android:letterSpacing="0.02" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" *"
                        android:textColor="@color/red_500"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <EditText
                    android:id="@+id/et_info_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColorHint="@color/slate_300"
                    android:textColor="@color/slate_900"
                    android:paddingTop="6dp"
                    android:paddingBottom="10dp"
                    android:inputType="textEmailAddress"
                    android:enabled="true"
                    android:maxLines="1" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/slate_200" />
            </LinearLayout>

            <!-- 전화번호 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/user_management_label_phone"
                    android:textColor="@color/slate_400"
                    android:textSize="12sp"
                    android:letterSpacing="0.02" />
                <EditText
                    android:id="@+id/et_info_tel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColorHint="@color/slate_300"
                    android:textColor="@color/slate_900"
                    android:paddingTop="6dp"
                    android:paddingBottom="10dp"
                    android:inputType="phone"
                    android:enabled="true"
                    android:maxLines="1" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/slate_200" />
            </LinearLayout>

            <!-- 휴대폰 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="28dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/user_management_label_mobile"
                    android:textColor="@color/slate_400"
                    android:textSize="12sp"
                    android:letterSpacing="0.02" />
                <EditText
                    android:id="@+id/et_info_hp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColorHint="@color/slate_300"
                    android:textColor="@color/slate_900"
                    android:paddingTop="6dp"
                    android:paddingBottom="10dp"
                    android:inputType="phone"
                    android:enabled="true"
                    android:maxLines="1" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/slate_200" />
            </LinearLayout>


            <!-- ===== 역할 관리 섹션 ===== -->
            <TextView
                android:id="@+id/tv_role_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/user_management_label_role_setup"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/slate_900"
                android:layout_marginBottom="16dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_roles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-4dp"
                android:layout_marginEnd="-4dp"
                android:layout_marginBottom="16dp"
                android:nestedScrollingEnabled="false"
                tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                tools:spanCount="2"
                tools:listitem="@layout/item_role_selection_grid" />





            <!-- ===== 가입일 섹션 ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingVertical="6dp"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/user_management_label_reg_date_format"
                    android:textColor="@color/slate_400"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_reg_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="2026. 01. 28. 오후 08:11"
                    android:textColor="@color/slate_400"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Loading Indicator -->
            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Pinned Bottom Button (Styled to match Invite screen) -->
    <Button
        android:id="@+id/btn_save_roles"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="@string/user_management_action_save_btn"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        android:letterSpacing="0.01"
        android:backgroundTint="@color/brand_primary"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="28dp"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
