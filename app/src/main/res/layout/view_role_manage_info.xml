<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_person_permission"
                android:background="@drawable/bg_oval_light_blue"
                android:padding="8dp"
                app:tint="@color/login_blue" />
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="역할 정보 수정"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_person_permission"
                app:tint="@color/gray_text"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="역할 표시 이름"
                android:textColor="@color/gray_text"
                android:textSize="12sp" />
        </LinearLayout>
        
        <EditText
            android:id="@+id/et_display_name"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_card_rounded_border"
            android:hint="예) 마케팅 매니저"
            android:paddingHorizontal="16dp"
            android:maxLines="1"
            android:inputType="text"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"
            tools:text="슈퍼 관리자" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_roles"
                app:tint="@color/gray_text"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="시스템 역할 코드"
                android:textColor="@color/gray_text"
                android:textSize="12sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/et_role_name"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_card_rounded_border"
            android:hint="예) admin"
            android:paddingHorizontal="16dp"
            android:maxLines="1"
            android:inputType="text"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"
            tools:text="super_admin" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/gray_text"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="설명"
                android:textColor="@color/gray_text"
                android:textSize="12sp" />
        </LinearLayout>
        
        <EditText
            android:id="@+id/et_description"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:gravity="top"
            android:background="@drawable/bg_card_rounded_border"
            android:hint="역할에 대한 상세한 설명을 적어주세요"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:inputType="textMultiLine"
            android:textSize="14sp"
            android:layout_marginBottom="24dp"
            tools:text="시스템 전체 관리 권한을 가진 최고 관리자" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
