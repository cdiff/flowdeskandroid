<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- 뒤로가기 및 타이틀 바 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="@color/white"
        android:elevation="1dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_chevron_left"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/slate_800"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tv_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/user_management_title_invite_new_member_simple"
            android:textColor="@color/slate_800"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 스크롤 영역 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/btn_invite">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- 대형 굵은 타이틀 -->
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/user_management_title_invite_new_member"
                android:textColor="@color/slate_900"
                android:textSize="24sp"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginBottom="28dp" />

            <!-- ===== 1. 계정 정보 ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/user_management_label_account_info"
                android:textColor="@color/slate_900"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- 사용자 ID (필수) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="2dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/user_management_label_user_id"
                        android:textColor="@color/slate_400"
                        android:textSize="12sp"
                        android:letterSpacing="0.02" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" *"
                        android:textColor="@color/red_500"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <EditText
                    android:id="@+id/et_user_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="john.doe"
                    android:textColorHint="@color/slate_300"
                    android:textColor="@color/slate_900"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingTop="6dp"
                    android:paddingBottom="10dp"
                    android:inputType="text"
                    android:maxLines="1" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/slate_200" />
            </LinearLayout>

            <!-- 비밀번호 (필수) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="2dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/user_management_label_password"
                        android:textColor="@color/slate_400"
                        android:textSize="12sp"
                        android:letterSpacing="0.02" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" *"
                        android:textColor="@color/red_500"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <EditText
                    android:id="@+id/et_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="6자 이상 입력"
                    android:textColorHint="@color/slate_300"
                    android:textColor="@color/slate_900"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingTop="6dp"
                    android:paddingBottom="10dp"
                    android:inputType="textPassword"
                    android:maxLines="1" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/slate_200" />
            </LinearLayout>

            <!-- 비밀번호 확인 (필수) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="28dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="2dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/user_management_label_password_confirm"
                        android:textColor="@color/slate_400"
                        android:textSize="12sp"
                        android:letterSpacing="0.02" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" *"
                        android:textColor="@color/red_500"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <EditText
                    android:id="@+id/et_password_confirm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="비밀번호 재입력"
                    android:textColorHint="@color/slate_300"
                    android:textColor="@color/slate_900"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingTop="6dp"
                    android:paddingBottom="10dp"
                    android:inputType="textPassword"
                    android:maxLines="1" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/slate_200" />
            </LinearLayout>



            <!-- ===== 2. 기본 정보 ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/user_management_label_basic_info"
                android:textColor="@color/slate_900"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- 이름 (필수) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="2dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/user_management_label_name"
                        android:textColor="@color/slate_400"
                        android:textSize="12sp"
                        android:letterSpacing="0.02" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" *"
                        android:textColor="@color/red_500"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <EditText
                    android:id="@+id/et_user_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="홍길동"
                    android:textColorHint="@color/slate_300"
                    android:textColor="@color/slate_900"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingTop="6dp"
                    android:paddingBottom="10dp"
                    android:inputType="text"
                    android:maxLines="1" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/slate_200" />
            </LinearLayout>

            <!-- 이메일 (필수) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="2dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/user_management_label_email"
                        android:textColor="@color/slate_400"
                        android:textSize="12sp"
                        android:letterSpacing="0.02" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" *"
                        android:textColor="@color/red_500"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <EditText
                    android:id="@+id/et_user_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="user@example.com"
                    android:textColorHint="@color/slate_300"
                    android:textColor="@color/slate_900"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingTop="6dp"
                    android:paddingBottom="10dp"
                    android:inputType="textEmailAddress"
                    android:maxLines="1" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/slate_200" />
            </LinearLayout>

            <!-- 전화번호 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/user_management_label_phone"
                    android:textColor="@color/slate_400"
                    android:textSize="12sp"
                    android:letterSpacing="0.02"
                    android:layout_marginBottom="2dp" />

                <EditText
                    android:id="@+id/et_user_tel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="02-1234-5678"
                    android:textColorHint="@color/slate_300"
                    android:textColor="@color/slate_900"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingTop="6dp"
                    android:paddingBottom="10dp"
                    android:inputType="phone"
                    android:maxLines="1" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/slate_200" />
            </LinearLayout>

            <!-- 휴대폰 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/user_management_label_mobile"
                    android:textColor="@color/slate_400"
                    android:textSize="12sp"
                    android:letterSpacing="0.02"
                    android:layout_marginBottom="2dp" />

                <EditText
                    android:id="@+id/et_user_hp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="010-1234-5678"
                    android:textColorHint="@color/slate_300"
                    android:textColor="@color/slate_900"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingTop="6dp"
                    android:paddingBottom="10dp"
                    android:inputType="phone"
                    android:maxLines="1" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/slate_200" />
            </LinearLayout>

            <!-- ===== 3. 역할 설정 ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/user_management_label_role_setup"
                android:textColor="@color/slate_900"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- 역할 선택 Grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_roles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-4dp"
                android:layout_marginEnd="-4dp"
                android:layout_marginBottom="16dp"
                android:nestedScrollingEnabled="false"
                tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                tools:spanCount="2"
                tools:listitem="@layout/item_role_selection_grid" />

            <TextView
                android:id="@+id/tv_selected_role"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:background="@drawable/bg_oval_light_blue"
                android:paddingHorizontal="16dp"
                android:text="@string/user_management_status_no_role_selected"
                android:textColor="@color/login_blue"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginBottom="24dp" />

            <!-- 로딩 및 에러 처리 컨테이너 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">
                <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_gravity="center" />
                <TextView
                    android:id="@+id/tv_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/red"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:visibility="gone" />
            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 하단 파란 둥근 버튼 -->
    <Button
        android:id="@+id/btn_invite"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="@string/user_management_action_invite"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        android:letterSpacing="0.01"
        android:backgroundTint="@color/brand_primary"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="28dp"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
