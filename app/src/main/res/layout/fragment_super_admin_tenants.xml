<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:fillViewport="true"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- ─── 안내 배너 (닫기 가능) ─── -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/banner_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rect_rounded_blue"
                android:padding="20dp"
                android:layout_marginHorizontal="2dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="30dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- 배경 장식 원 -->
                <View
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:background="@drawable/ic_tenant_banner"
                    android:alpha="0.15"
                    android:scaleX="1.6"
                    android:scaleY="1.6"
                    android:rotation="-15"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginEnd="-15dp"
                    android:layout_marginBottom="-15dp" />

                <!-- X 닫기 버튼 -->
                <ImageView
                    android:id="@+id/btn_close_banner"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_close"
                    app:tint="#FFFFFFCC"
                    android:padding="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- 타이틀 -->
                <TextView
                    android:id="@+id/tv_banner_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="테넌트 관리란?"
                    android:textColor="#FFFFFFCC"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btn_close_banner"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_banner_subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="신규 도입 고객사를 생성하세요"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btn_close_banner"
                    app:layout_constraintTop_toBottomOf="@id/tv_banner_title" />

                <!-- 설명 -->
                <TextView
                    android:id="@+id/tv_banner_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="고객사별로 독립적인 업무 환경(테넌트)을 구성하고,\n상태를 활성/비활성화하여 시스템 접근을 제어합니다."
                    android:textColor="#CCE0FF"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.4"
                    android:layout_marginTop="14dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_banner_subtitle" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ─── 검색바 (독립형 둥근 카드) ─── -->
            <LinearLayout
                android:id="@+id/ll_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_white_rounded_12dp"
                android:elevation="1dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="@color/gray_text"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/et_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="테넌트명 / 도메인 / 이메일 검색..."
                    android:textColorHint="@color/gray_text"
                    android:textSize="13sp"
                    android:textColor="@color/black"
                    android:maxLines="1"
                    android:inputType="text" />
            </LinearLayout>

            <!-- ─── 리스트 헤더 (제목 + 추가 버튼) ─── -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tv_list_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="테넌트 목록"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/btn_create_tenant" />

                <!-- + 새 테넌트 버튼 -->
                <ImageView
                    android:id="@+id/btn_create_tenant"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_add_thin"
                    app:tint="@color/black"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ─── 헤더 하단 소형 통계 텍스트 ─── -->
            <LinearLayout
                android:id="@+id/ll_badges"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tv_badge_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="총 15개"
                    android:textColor="@color/gray_text"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  •  "
                    android:textColor="#D1D5DB"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_badge_active"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="활성 13개"
                    android:textColor="@color/green_accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  •  "
                    android:textColor="#D1D5DB"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_badge_inactive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="비활성 2개"
                    android:textColor="@color/red"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ─── 리스트 영역 (RecyclerView 및 상태 뷰) ─── -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:clipChildren="false">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_tenants"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="4"
                    tools:listitem="@layout/item_super_admin_tenant"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:paddingBottom="12dp"
                    android:clipToPadding="false"
                    android:clipChildren="false" />

                <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_margin="40dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <LinearLayout
                    android:id="@+id/ll_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="40dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@android:drawable/ic_menu_sort_by_size"
                        app:tint="#CBD5E1"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tv_empty_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="등록된 테넌트가 없습니다"
                        android:textColor="@color/gray_text"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="플러스(+) 버튼으로 추가해보세요"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
