<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F4F6">

    <!-- Header / Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        app:navigationIcon="@drawable/ic_chevron_left"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="역할 상세"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_gravity="center" />
    </androidx.appcompat.widget.Toolbar>

    <View
        android:id="@+id/div_toolbar"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EAEAEA"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/div_toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:clipToPadding="false">

            <!-- 1. Role Info Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded"
                android:padding="24dp"
                android:elevation="1dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/iv_role_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_shield_check"
                    android:background="@drawable/bg_oval_light_blue"
                    android:padding="12dp"
                    app:tint="@color/login_blue"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tv_role_display_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    tools:text="슈퍼 관리자"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginStart="16dp"
                    app:layout_constraintTop_toTopOf="@id/iv_role_icon"
                    app:layout_constraintStart_toEndOf="@id/iv_role_icon"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tv_role_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="@super_admin"
                    android:textColor="@color/gray_text"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_role_display_name"
                    app:layout_constraintStart_toStartOf="@id/tv_role_display_name" />

                <!-- Status Badge -->
                <LinearLayout
                    android:id="@+id/ll_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_badge_gray_border"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_role_name"
                    app:layout_constraintStart_toStartOf="@id/tv_role_display_name">
                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_oval_green"
                        android:layout_marginEnd="6dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="활성화됨"
                        android:textColor="@color/black"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:id="@+id/div_info"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F0F0F0"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@id/ll_status_badge" />

                <TextView
                    android:id="@+id/tv_role_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="시스템 전체 관리 권한을 가진 최고 관리자입니다. 이 역할은 모든 메뉴와 리소스에 자유롭게 접근할 수 있습니다."
                    android:textColor="#5A687A"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/div_info" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 2. Permissions Detail Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded"
                android:padding="24dp"
                android:elevation="1dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tv_perm_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="세부 권한 (17개)"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <View
                    android:id="@+id/div_perm"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F0F0F0"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_perm_title" />

                <!-- Mockup List of pages & actions. In real implementation, this will be generated via RecyclerView -->
                <LinearLayout
                    android:id="@+id/ll_permissions_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/div_perm">

                    <!-- Mock Item 1 -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_card_rounded_border"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tv_page1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="테넌트 관리"
                            android:textStyle="bold"
                            android:textColor="#3A485A"
                            android:textSize="14sp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                        <TextView
                            android:id="@+id/tv_page1_code"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="super.tenants"
                            android:textSize="11sp"
                            android:textColor="@color/gray_text"
                            android:layout_marginTop="2dp"
                            app:layout_constraintTop_toBottomOf="@id/tv_page1"
                            app:layout_constraintStart_toStartOf="parent" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="조회" android:background="#E1F0FF" android:textColor="#0052CC" android:textSize="11sp" android:paddingHorizontal="8dp" android:paddingVertical="4dp" android:layout_marginEnd="4dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="생성" android:background="#E3FCEF" android:textColor="#006644" android:textSize="11sp" android:paddingHorizontal="8dp" android:paddingVertical="4dp" android:layout_marginEnd="4dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="수정" android:background="#FFF0B3" android:textColor="#FF8B00" android:textSize="11sp" android:paddingHorizontal="8dp" android:paddingVertical="4dp" android:layout_marginEnd="4dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="삭제" android:background="#FFEBE6" android:textColor="#DE350B" android:textSize="11sp" android:paddingHorizontal="8dp" android:paddingVertical="4dp" />
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Mock Item 2 -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="0dp"
                        android:background="@drawable/bg_card_rounded_border"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tv_page2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="권한 카탈로그"
                            android:textStyle="bold"
                            android:textColor="#3A485A"
                            android:textSize="14sp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                        <TextView
                            android:id="@+id/tv_page2_code"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="permissions"
                            android:textSize="11sp"
                            android:textColor="@color/gray_text"
                            android:layout_marginTop="2dp"
                            app:layout_constraintTop_toBottomOf="@id/tv_page2"
                            app:layout_constraintStart_toStartOf="parent" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="조회" android:background="#E1F0FF" android:textColor="#0052CC" android:textSize="11sp" android:paddingHorizontal="8dp" android:paddingVertical="4dp" />
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 3. Assigned Users Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded"
                android:padding="24dp"
                android:elevation="1dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tv_users_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="할당된 팀원 (3명)"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <View
                    android:id="@+id/div_users"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F0F0F0"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_users_title" />

                <LinearLayout
                    android:id="@+id/ll_users_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/div_users">

                    <!-- Mock User 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">
                        
                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:text="J"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="@drawable/bg_oval_light_blue"
                            android:textColor="@color/login_blue" />
                            
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="John Doe" android:textColor="@color/black" android:textStyle="bold" android:textSize="14sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="john.doe@example.com" android:textColor="@color/gray_text" android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/gray_text" />
                    </LinearLayout>

                    <!-- Mock User 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        
                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:text="태"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="@drawable/bg_oval_light_blue"
                            android:textColor="@color/login_blue" />
                            
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="태수zla" android:textColor="@color/black" android:textStyle="bold" android:textSize="14sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="sod@naver.com" android:textColor="@color/gray_text" android:textSize="12sp" />
                        </LinearLayout>
                        
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/gray_text" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Loading Indicator -->
            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginTop="16dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
