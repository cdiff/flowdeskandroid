<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:padding="20dp">

    <!-- Avatar Placeholder -->
    <TextView
        android:id="@+id/tv_avatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        tools:text="김"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/login_blue"
        android:background="@drawable/bg_oval_light_blue"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/tv_user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="김철수"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/tv_avatar"
        app:layout_constraintTop_toTopOf="@id/tv_avatar"
        app:layout_constraintBottom_toTopOf="@id/tv_user_email" />

    <TextView
        android:id="@+id/tv_role_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="관리자"
        android:textSize="10sp"
        android:textColor="@color/white"
        android:background="@drawable/bg_badge_black"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/tv_user_name"
        app:layout_constraintTop_toTopOf="@id/tv_user_name"
        app:layout_constraintBottom_toBottomOf="@id/tv_user_name" />

    <ImageView
        android:id="@+id/iv_status"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_check_circle"
        app:tint="@color/green_accent"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/tv_role_badge"
        app:layout_constraintTop_toTopOf="@id/tv_user_name"
        app:layout_constraintBottom_toBottomOf="@id/tv_user_name" />

    <TextView
        android:id="@+id/tv_user_email"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="ceo@marketing.com"
        android:textSize="12sp"
        android:textColor="@color/gray_text"
        app:layout_constraintStart_toStartOf="@id/tv_user_name"
        app:layout_constraintBottom_toBottomOf="@id/tv_avatar"
        app:layout_constraintTop_toBottomOf="@id/tv_user_name"
        app:layout_constraintEnd_toStartOf="@id/iv_arrow" />

    <ImageView
        android:id="@+id/iv_arrow"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/gray_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
