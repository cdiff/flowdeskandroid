<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ─── 1. 상단 실버-그레이 헤더 영역 (써클 탭 포함) ─── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F3F4F6"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="32dp"
                android:paddingBottom="0dp">

                <!-- 타이틀 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="상담 목록"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#111827"
                    android:layout_marginBottom="4dp" />

                <!-- 설명 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="인입된 고객 상담 신청 내역을 관리하고 배정합니다."
                    android:textSize="13sp"
                    android:textColor="@color/gray_text"
                    android:layout_marginBottom="24dp" />

                <!-- 상태 써클 탭 컨테이너 (바닥 경계면에 밀착 배치) -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="0dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="0dp"
                    android:clipChildren="true"
                    android:clipToPadding="true">

                    <!-- 1. 전체 요약 탭 라벨 (직접 배치) -->
                    <TextView
                        android:id="@+id/tv_status_total_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#111827"
                        android:text="전체"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="@id/card_total_circle"
                        app:layout_constraintEnd_toEndOf="@id/card_total_circle" />

                    <!-- 2. 전체 요약 탭 서클 (직접 배치) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_total_circle"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="#1E293B"
                        android:clipToOutline="true"
                        android:clipChildren="true"
                        app:layout_constraintTop_toBottomOf="@id/tv_status_total_label"
                        app:layout_constraintStart_toStartOf="parent"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:id="@+id/tv_status_total_count_badge"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            tools:text="20" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 3. 전체 요약 탭 클릭용 투명 터치 타겟 뷰 -->
                    <View
                        android:id="@+id/layout_tab_total"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@android:color/transparent"
                        app:layout_constraintTop_toTopOf="@id/tv_status_total_label"
                        app:layout_constraintBottom_toBottomOf="@id/card_total_circle"
                        app:layout_constraintStart_toStartOf="@id/card_total_circle"
                        app:layout_constraintEnd_toEndOf="@id/card_total_circle" />

                    <!-- 4. 세로 구분선 (직접 배치, 서클 우측에 정렬) -->
                    <View
                        android:id="@+id/v_total_divider"
                        android:layout_width="1.5dp"
                        android:layout_height="24dp"
                        android:background="#D1D5DB"
                        android:layout_marginStart="20dp"
                        app:layout_constraintTop_toTopOf="@id/card_total_circle"
                        app:layout_constraintBottom_toBottomOf="@id/card_total_circle"
                        app:layout_constraintStart_toEndOf="@id/card_total_circle" />

                    <!-- 5. 나머지 필터 상태 탭 가로 스크롤 (구분선 오른쪽에서 시작하여 끝까지) -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_status_tabs"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:overScrollMode="never"
                        android:clipToPadding="true"
                        android:clipChildren="true"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_counsel_status_tab"
                        tools:itemCount="5"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/v_total_divider"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>

            <!-- ─── 2. 하단 본문 소프트-그레이 영역 (필터 및 리스트 카드) ─── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F9FAFB"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="32dp"
                android:paddingBottom="24dp">

                <!-- 검색 필드 (독립형 라운드 카드) -->
                <LinearLayout
                    android:id="@+id/ll_search_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_white_rounded_12dp"
                    android:elevation="1dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_menu_search"
                        app:tint="@color/gray_text"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/et_search"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:hint="고객명, 연락처로 검색..."
                        android:textColorHint="@color/gray_text"
                        android:textSize="13sp"
                        android:textColor="@color/black"
                        android:maxLines="1"
                        android:inputType="text" />
                </LinearLayout>

                <!-- 필터 칩 영역 (가로 스크롤) -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:overScrollMode="never"
                    android:layout_marginBottom="20dp"
                    android:clipToPadding="false">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="2dp">

                        <!-- 기간 필터 칩 -->
                        <LinearLayout
                            android:id="@+id/btn_filter_date"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_chip_filter"
                            android:gravity="center_vertical"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:layout_marginEnd="8dp">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/ic_calendar"
                                app:tint="#475569"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:id="@+id/tv_filter_date"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="최근 7일"
                                android:textSize="12sp"
                                android:textColor="#475569" />

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_arrow_drop_down"
                                app:tint="#475569"
                                android:layout_marginStart="4dp" />
                        </LinearLayout>

                        <!-- 담당자 필터 칩 -->
                        <LinearLayout
                            android:id="@+id/btn_filter_manager"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_chip_filter"
                            android:gravity="center_vertical"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:id="@+id/tv_filter_manager"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="담당자: 전체"
                                android:textSize="12sp"
                                android:textColor="#475569" />

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_arrow_drop_down"
                                app:tint="#475569"
                                android:layout_marginStart="4dp" />
                        </LinearLayout>

                        <!-- 웹사이트 필터 칩 -->
                        <LinearLayout
                            android:id="@+id/btn_filter_website"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_chip_filter"
                            android:gravity="center_vertical"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp">

                            <TextView
                                android:id="@+id/tv_filter_website"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="웹사이트: 전체"
                                android:textSize="12sp"
                                android:textColor="#475569" />

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_arrow_drop_down"
                                app:tint="#475569"
                                android:layout_marginStart="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- 리스트 정보 영역 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp"
                    android:layout_marginHorizontal="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="상담 내역"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#1E293B" />

                    <TextView
                        android:id="@+id/tv_counsel_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textSize="12sp"
                        android:textColor="@color/gray_text"
                        tools:text="총 20건" />
                </LinearLayout>

                <!-- 상담 목록 카드 리사이클러뷰 컨테이너 -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="200dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_counsels"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_counsel_list"
                        tools:itemCount="3" />

                    <!-- 로딩 프로그레스 바 -->
                    <ProgressBar
                        android:id="@+id/progress_bar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="gone" />

                    <!-- 빈 내역 표시 화면 -->
                    <LinearLayout
                        android:id="@+id/ll_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingVertical="60dp"
                        android:visibility="gone"
                        tools:visibility="gone">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@android:drawable/ic_menu_sort_by_size"
                            app:tint="#CBD5E1"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="조회된 상담 내역이 없습니다."
                            android:textColor="@color/gray_text"
                            android:textSize="14sp"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="필터 조건을 확인해보세요."
                            android:textColor="#CBD5E1"
                            android:textSize="12sp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
