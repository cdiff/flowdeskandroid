<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB">

    <!-- Toolbar (fragment_role_detail.xml 방식과 동일) -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        app:navigationIcon="@drawable/ic_chevron_left"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="역할 관리"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/btn_save_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="저장"
            android:layout_marginEnd="16dp"
            android:textColor="@color/login_blue"
            android:textStyle="bold"
            android:textSize="16sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp" />
    </androidx.appcompat.widget.Toolbar>

    <!-- 구분선 -->
    <View
        android:id="@+id/div_toolbar"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EAEAEA"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <!-- TabLayout -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabIndicatorColor="@color/login_blue"
        app:tabIndicatorHeight="3dp"
        app:tabSelectedTextColor="@color/login_blue"
        app:tabTextColor="#6B7280"
        app:tabTextAppearance="@style/TabTextStyle"
        android:background="@color/white"
        app:layout_constraintTop_toBottomOf="@id/div_toolbar" />

    <!-- ViewPager2 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#F9FAFB"
        app:layout_constraintTop_toBottomOf="@id/tab_layout"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
