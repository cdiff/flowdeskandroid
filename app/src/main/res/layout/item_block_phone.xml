<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="5dp"
    android:background="@drawable/bg_white_rounded_12dp"
    android:clipToOutline="true"
    android:outlineProvider="background"
    android:baselineAligned="false"
    android:clickable="true"
    android:focusable="true">

    <!-- ─── 좌측 빨간 액센트 바 (카드 전체 높이) ─── -->
    <View
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@color/color_error" />

    <!-- ─── 콘텐츠 영역 ─── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <!-- 휴대폰 번호 -->
        <TextView
            android:id="@+id/tv_phone_number"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="010-1234-5678"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.01"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tv_phone_blocked_at"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 날짜 (우측, baseline 맞춤) -->
        <TextView
            android:id="@+id/tv_phone_blocked_at"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="03.23"
            android:textColor="@color/text_disabled"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBaseline_toBaselineOf="@id/tv_phone_number" />

        <!-- 차단 사유 -->
        <TextView
            android:id="@+id/tv_phone_reason"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            tools:text="스팸 반복 접수 번호"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            android:lineSpacingMultiplier="1.3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_phone_number" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
