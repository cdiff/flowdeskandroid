<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:paddingTop="@dimen/spacing_xl"
    android:paddingBottom="10dp"
    android:paddingHorizontal="@dimen/spacing_2xl"
    android:minWidth="300dp">

    <!-- HEX 입력 + 컬러 미리보기 행 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/spacing_lg">

        <!-- HEX 라벨 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HEX"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginEnd="10dp" />

        <!-- # 기호 + EditText 입력 박스 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card_rounded_border"
            android:paddingHorizontal="@dimen/spacing_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#"
                android:textColor="@color/text_disabled"
                android:textSize="@dimen/text_size_base"
                android:layout_marginEnd="4dp" />

            <EditText
                android:id="@+id/et_hex_value"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:text="3B82F6"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_base"
                android:inputType="textCapCharacters"
                android:maxLines="1"
                android:maxLength="6"
                android:fontFamily="monospace"
                android:importantForAutofill="no" />
        </LinearLayout>

        <!-- 컬러 미리보기 원 -->
        <View
            android:id="@+id/view_color_preview_picker"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="@dimen/spacing_md"
            android:background="@drawable/bg_circle_blue" />
    </LinearLayout>

    <!-- 컬러피커 팔레트 (정사각형, 크게) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:clipToOutline="true"
        android:layout_marginBottom="14dp">

        <com.skydoves.colorpickerview.ColorPickerView
            android:id="@+id/color_picker_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:selector="@drawable/bg_selector_ring" />
    </FrameLayout>

    <!-- Hue SeekBar — 팔레트와 같은 너비 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/icon_size_md"
        android:layout_marginBottom="@dimen/spacing_sm">

        <!-- 무지개 배경 바 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_gravity="center_vertical"
            android:layout_marginHorizontal="@dimen/spacing_md"
            android:background="@drawable/bg_rainbow_gradient" />

        <!-- 투명 트랙 SeekBar (썸만 보임) -->
        <SeekBar
            android:id="@+id/hue_seek_bar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:max="360"
            android:progress="200"
            android:progressDrawable="@android:color/transparent"
            android:background="@android:color/transparent"
            android:splitTrack="false"
            android:thumb="@drawable/bg_hue_thumb"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md" />
    </FrameLayout>

    <!-- 취소 | 완료 버튼 행 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- 취소 -->
        <TextView
            android:id="@+id/btn_cancel_color"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="취소"
            android:textColor="@color/brand_primary"
            android:textSize="@dimen/text_size_base"
            android:fontFamily="sans-serif-medium" />

        <!-- 세로 구분선 -->
        <View
            android:layout_width="@dimen/divider_thickness"
            android:layout_height="15dp"
            android:layout_gravity="center_vertical"
            android:background="@color/bg_divider" />

        <!-- 완료 -->
        <TextView
            android:id="@+id/btn_confirm_color"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="완료"
            android:textColor="@color/brand_primary"
            android:textSize="@dimen/text_size_base"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

</LinearLayout>
