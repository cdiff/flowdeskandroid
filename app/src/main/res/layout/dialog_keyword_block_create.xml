<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingTop="16dp">

    <!-- Handle line at top -->
    <View
        android:id="@+id/handle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#E5E5E5"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/btn_close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_close"
        app:tint="@color/gray_text"
        android:layout_marginEnd="20dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_header_title"
        app:layout_constraintBottom_toBottomOf="@id/tv_header_title" />

    <!-- ─── 헤더 타이틀 ─── -->
    <TextView
        android:id="@+id/tv_header_title"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:text="금칙어 등록"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/handle" />

    <TextView
        android:id="@+id/tv_header_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="채팅 및 상담 입력창에서 사용할 수 없는 금칙어를 설정합니다."
        android:textColor="@color/gray_text"
        android:textSize="14sp"
        android:layout_marginEnd="16dp"
        app:layout_constraintStart_toStartOf="@id/tv_header_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_header_title" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv_create"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/tv_header_subtitle"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="20dp">

            <!-- Section: 등록 방식 선택 -->
            <LinearLayout
                android:id="@+id/fl_mode_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="등록 방식 *"
                    android:textColor="@color/gray_text"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_segment_container"
                    android:padding="3dp"
                    android:layout_marginBottom="16dp">

                    <View
                        android:id="@+id/v_segment_selector"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_segment_item_selected" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btn_mode_single"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="단일 등록"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#3B82F6"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/btn_mode_bulk"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="대량 등록"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#64748B"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- Section: 단일 금칙어 입력 -->
            <LinearLayout
                android:id="@+id/ll_single_keyword_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="금칙어 *"
                    android:textColor="@color/gray_text"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/et_block_word"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_card_rounded_border"
                    android:hint="예) 비속어"
                    android:paddingHorizontal="16dp"
                    android:maxLines="1"
                    android:inputType="text"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp" />
            </LinearLayout>

            <!-- Section: 대량 금칙어 입력 -->
            <LinearLayout
                android:id="@+id/ll_bulk_keyword_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="금칙어 목록 (줄바꿈 구분) *"
                    android:textColor="@color/gray_text"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/et_block_words"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:gravity="top"
                    android:background="@drawable/bg_card_rounded_border"
                    android:hint="줄바꿈으로 구분해 여러 금칙어를 입력하세요.\n예)\n비속어\n욕설"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:inputType="textMultiLine"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp" />
            </LinearLayout>

            <!-- Section: 매칭 타입 선택 (가로형 3개 라디오 카드) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="매칭 타입 *"
                android:textColor="@color/gray_text"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rg_match_type"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <RadioButton
                    android:id="@+id/rb_match_contains"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/selector_custom_radio_bg"
                    android:button="@null"
                    android:drawableEnd="@drawable/selector_custom_radio_indicator"
                    android:gravity="center_vertical|start"
                    android:paddingHorizontal="12dp"
                    android:text="포함 차단"
                    android:textColor="@color/selector_custom_radio_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rb_match_exact"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/selector_custom_radio_bg"
                    android:button="@null"
                    android:drawableEnd="@drawable/selector_custom_radio_indicator"
                    android:gravity="center_vertical|start"
                    android:paddingHorizontal="12dp"
                    android:text="완전 일치"
                    android:textColor="@color/selector_custom_radio_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/rb_match_regex"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/selector_custom_radio_bg"
                    android:button="@null"
                    android:drawableEnd="@drawable/selector_custom_radio_indicator"
                    android:gravity="center_vertical|start"
                    android:paddingHorizontal="12dp"
                    android:text="패턴 차단"
                    android:textColor="@color/selector_custom_radio_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </RadioGroup>

            <!-- Section: 차단 사유 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="차단 사유 *"
                android:textColor="@color/gray_text"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_reason"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:gravity="top"
                android:background="@drawable/bg_card_rounded_border"
                android:hint="차단하는 사유를 입력해주세요. (예: 비속어 필터링)"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:inputType="textMultiLine"
                android:textSize="14sp"
                android:layout_marginBottom="20dp" />

            <!-- Loading Indicator Container -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">
                <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_gravity="center" />
                <TextView
                    android:id="@+id/tv_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/red"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:visibility="gone" />
            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:background="@color/white"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_create"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="등록하기"
            android:textColor="@color/white"
            android:background="@drawable/bg_rect_rounded_blue" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
