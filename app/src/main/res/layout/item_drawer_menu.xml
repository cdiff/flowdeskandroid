<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_drawer_menu_item"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_marginHorizontal="@dimen/spacing_md"
    android:layout_marginVertical="@dimen/spacing_2xs"
    android:background="@drawable/bg_drawer_item_selector"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/spacing_lg">

    <ImageView
        android:id="@+id/iv_menu_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_default_menu"
        app:tint="@color/slate_600" />

    <TextView
        android:id="@+id/tv_menu_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:textColor="@color/slate_900"
        android:textSize="@dimen/text_size_base"
        android:textStyle="bold"
        android:text="메뉴 이름" />

    <ImageView
        android:id="@+id/iv_chevron"
        android:layout_width="@dimen/spacing_lg"
        android:layout_height="@dimen/spacing_lg"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/slate_400" />

</LinearLayout>
