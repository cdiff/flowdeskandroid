<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@drawable/bg_card_rounded"
    android:orientation="vertical"
    android:padding="16dp"
    android:elevation="1dp"
    android:layout_marginBottom="16dp">

    <!-- 카드 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="월별 증가 추이"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#111827" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="최근 6개월"
            android:textSize="11sp"
            android:textColor="@color/login_blue"
            android:background="@drawable/bg_badge_rounded_blue_border"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp" />
    </LinearLayout>

    <!-- 차트 영역 -->
    <FrameLayout
        android:id="@+id/chart_container"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@color/white"
        android:layout_marginTop="8dp">

        <!-- MPAndroidChart LineChart -->
        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/line_chart"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tv_chart_placeholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="차트 데이터 로딩 중..."
            android:textSize="12sp"
            android:textColor="#CCCCCC"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 범례 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="12dp">

        <View android:layout_width="16dp" android:layout_height="2dp"
            android:background="@color/login_blue" android:layout_gravity="center_vertical" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="상담" android:textSize="11sp" android:textColor="@color/gray_text"
            android:layout_marginStart="4dp" android:layout_marginEnd="16dp" />

        <View android:layout_width="16dp" android:layout_height="2dp"
            android:background="@color/green_accent" android:layout_gravity="center_vertical" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="사용자" android:textSize="11sp" android:textColor="@color/gray_text"
            android:layout_marginStart="4dp" android:layout_marginEnd="16dp" />

        <View android:layout_width="16dp" android:layout_height="2dp"
            android:background="@color/red" android:layout_gravity="center_vertical" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="테넌트" android:textSize="11sp" android:textColor="@color/gray_text"
            android:layout_marginStart="4dp" />
    </LinearLayout>

</LinearLayout>
