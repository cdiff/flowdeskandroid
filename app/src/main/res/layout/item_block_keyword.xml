<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="5dp"
    android:background="@drawable/bg_white_rounded_12dp"
    android:clipToOutline="true"
    android:outlineProvider="background"
    android:baselineAligned="false"
    android:clickable="true"
    android:focusable="true">

    <!-- ─── 좌측 주황 액센트 바 (카드 전체 높이) ─── -->
    <View
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@color/color_warning" />

    <!-- ─── 콘텐츠 영역 ─── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <!-- 금칙어 -->
        <TextView
            android:id="@+id/tv_keyword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="욕설"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tv_matching_type"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBaseline_toBaselineOf="@id/tv_matching_type" />

        <!-- 매칭 타입 뱃지 (우측) -->
        <TextView
            android:id="@+id/tv_matching_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="CONTAINS"
            android:textColor="@color/brand_primary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_badge_rounded_blue_border"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 차단 사유 -->
        <TextView
            android:id="@+id/tv_keyword_reason"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            tools:text="비속어 및 혐오 표현"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            android:lineSpacingMultiplier="1.3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_keyword" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
