<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F9FAFB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 다른 권한 복사하기 버튼 (안내 박스 형태) -->
        <LinearLayout
            android:id="@+id/btn_copy_permissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card_elevated"
            android:elevation="2dp"
            android:padding="16dp"
            android:layout_marginBottom="24dp">
            
            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_roles"
                app:tint="@color/login_blue"/>
                
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="다른 권한 템플릿 가져오기"
                    android:textColor="#111827"
                    android:textStyle="bold"
                    android:textSize="15sp"/>
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="다른 역할의 설정값을 복사하여 덮어씌웁니다"
                    android:textColor="@color/gray_text"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
            
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="#D1D5DB"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="세부 권한 관리"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#111827" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="각 메뉴별 접근 및 행동 권한을 켜고 끌 수 있습니다."
            android:textSize="13sp"
            android:textColor="@color/gray_text"
            android:layout_marginTop="4dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_detailed_permissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:nestedScrollingEnabled="false"
            tools:itemCount="3"
            tools:listitem="@layout/item_role_manage_permission_group"/>
            
        <View
            android:layout_width="match_parent"
            android:layout_height="40dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
