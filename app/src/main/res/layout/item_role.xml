<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:background="?attr/selectableItemBackground">

    <!-- Role Display Name -->
    <TextView
        android:id="@+id/tv_role_display_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="슈퍼 관리자"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Role System Name (roleName) -->
    <TextView
        android:id="@+id/tv_role_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="super_admin"
        android:textColor="@color/gray_text"
        android:textSize="12sp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/tv_role_display_name"
        app:layout_constraintBottom_toBottomOf="@id/tv_role_display_name"
        app:layout_constraintTop_toTopOf="@id/tv_role_display_name"/>

    <!-- More Options Menu -->
    <ImageView
        android:id="@+id/iv_more_options"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/ic_menu_more"
        app:tint="@color/gray_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:padding="2dp"
        android:background="?attr/selectableItemBackgroundBorderless"/>

    <!-- Description -->
    <TextView
        android:id="@+id/tv_role_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="시스템 전체 관리 권한을 가진 최고 관리자"
        android:textColor="@color/gray_text"
        android:textSize="13sp"
        android:layout_marginTop="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_role_display_name"
        app:layout_constraintEnd_toStartOf="@id/iv_more_options"/>

    <!-- Status Badge (isActive) -->
    <TextView
        android:id="@+id/tv_role_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="활성"
        android:textColor="@color/green_accent"
        android:textSize="10sp"
        android:background="#E8F5E9"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_role_description"/>

    <!-- Created At Date -->
    <TextView
        android:id="@+id/tv_created_at"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="2026.02.17 생성"
        android:textColor="@color/gray_text"
        android:textSize="11sp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/tv_role_status"
        app:layout_constraintBottom_toBottomOf="@id/tv_role_status"
        app:layout_constraintTop_toTopOf="@id/tv_role_status"/>

    <!-- Info Row for userCount & permissionCount -->
    <LinearLayout
        android:id="@+id/ll_info_counts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card_rounded_border"
        android:padding="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_role_status">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_users"
                app:tint="@color/gray_text"
                android:layout_marginEnd="6dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="할당 사용자"
                android:textColor="@color/gray_text"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/tv_user_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="2명"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#E5E5E5"
            android:layout_marginHorizontal="12dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/ic_lock_lock"
                app:tint="@color/gray_text"
                android:layout_marginEnd="6dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="설정된 권한"
                android:textColor="@color/gray_text"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/tv_permission_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="50개"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Buttons for actions (Detail, Permissions) -->
    <LinearLayout
        android:id="@+id/ll_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_info_counts">

        <!-- Permissions Management (PUT/PATCH /roles/{id}/permissions) -->
        <TextView
            android:id="@+id/btn_manage_permissions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="권한 관리"
            android:textColor="@color/login_blue"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_badge_rounded_blue_border"
            android:paddingVertical="8dp"
            android:layout_marginEnd="6dp"/>

        <!-- View/Edit Details (GET/PATCH /roles/{id}) -->
        <TextView
            android:id="@+id/btn_edit_role"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="상세 보기"
            android:textColor="@color/gray_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_card_rounded_border"
            android:paddingVertical="8dp"
            android:layout_marginStart="6dp"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F0F0F0"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/ll_actions"/>

</androidx.constraintlayout.widget.ConstraintLayout>
