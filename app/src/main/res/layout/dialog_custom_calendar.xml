<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- 1. 상단 타이틀 바 (뒤로가기 버튼) -->
    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:padding="8dp"
        android:src="@drawable/ic_chevron_left"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="#1E293B"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. 날짜 선택 정보 요약 바 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_date_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        app:layout_constraintTop_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 시작일 섹션 -->
        <TextView
            android:id="@+id/tv_start_date_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="시작일"
            android:textSize="12sp"
            android:textColor="#64748B"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_start_date_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="시작일 선택"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#4285F4"
            app:layout_constraintTop_toBottomOf="@id/tv_start_date_label"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- 세로 구분선 -->
        <View
            android:id="@+id/v_summary_divider"
            android:layout_width="1dp"
            android:layout_height="36dp"
            android:background="#E2E8F0"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 종료일 섹션 -->
        <TextView
            android:id="@+id/tv_end_date_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="종료일"
            android:textSize="12sp"
            android:textColor="#64748B"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/v_summary_divider"
            android:layout_marginStart="24dp" />

        <TextView
            android:id="@+id/tv_end_date_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="종료일 선택"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#4285F4"
            app:layout_constraintTop_toBottomOf="@id/tv_end_date_label"
            app:layout_constraintStart_toStartOf="@id/tv_end_date_label" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 3. 구분선 -->
    <View
        android:id="@+id/v_header_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/layout_date_summary" />

    <!-- 4. 요일 헤더 영역 -->
    <LinearLayout
        android:id="@+id/layout_week_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="10dp"
        android:paddingHorizontal="8dp"
        app:layout_constraintTop_toBottomOf="@id/v_header_divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="일"
            android:textSize="12sp"
            android:textColor="#64748B" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="월"
            android:textSize="12sp"
            android:textColor="#64748B" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="화"
            android:textSize="12sp"
            android:textColor="#64748B" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="수"
            android:textSize="12sp"
            android:textColor="#64748B" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="목"
            android:textSize="12sp"
            android:textColor="#64748B" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="금"
            android:textSize="12sp"
            android:textColor="#64748B" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="토"
            android:textSize="12sp"
            android:textColor="#64748B" />
    </LinearLayout>

    <View
        android:id="@+id/v_week_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0"
        app:layout_constraintTop_toBottomOf="@id/layout_week_header" />

    <!-- 5. 달력 월별 스크롤 RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_calendar_months"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/v_week_divider"
        app:layout_constraintBottom_toTopOf="@id/btn_confirm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 6. 하단 확인 버튼 -->
    <TextView
        android:id="@+id/btn_confirm"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="16dp"
        android:background="@drawable/bg_rect_rounded_blue"
        android:gravity="center"
        android:text="확인"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
