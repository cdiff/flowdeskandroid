<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.example.flowdesk_android.feature.main.MainActivity">

    <!-- Main Content View -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Bar (통일된 #F8FAFC 바탕색) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/topbar_min_height"
            android:background="@color/bg_page"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:paddingVertical="@dimen/spacing_md"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Sub Screen Back Button (서브 상세 화면에서만 표출: ←) -->
            <ImageView
                android:id="@+id/btn_nav_back"
                android:layout_width="@dimen/icon_size_md"
                android:layout_height="@dimen/icon_size_md"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/spacing_xs"
                android:src="@drawable/ic_chevron_left"
                android:visibility="gone"
                app:tint="@color/text_primary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Page Title -->
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/spacing_md"
                android:text="사용자 · 권한"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_lg"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/btn_nav_back"
                app:layout_constraintEnd_toStartOf="@id/ll_right_actions"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Top Right Actions: Profile Icon & Hamburger Icon -->
            <LinearLayout
                android:id="@+id/ll_right_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <!-- MyPage Profile Icon -->
                <ImageView
                    android:id="@+id/iv_person"
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="5dp"
                    android:src="@drawable/ic_user"
                    app:tint="@color/text_primary" />

                <!-- Hamburger Menu Icon (≡) -->
                <ImageView
                    android:id="@+id/btn_menu_hamburger"
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="@dimen/spacing_xs"
                    android:src="@drawable/ic_menu_hamburger"
                    app:tint="@color/text_primary" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- NavHost Fragment Container -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/nav_host_fragment"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:defaultNavHost="true"
            app:navGraph="@navigation/nav_graph_main"
            app:layout_constraintTop_toBottomOf="@id/top_bar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Side Navigation Drawer Container -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/drawer_fragment_container"
        android:name="com.example.flowdesk_android.feature.main.drawer.MainDrawerFragment"
        android:layout_width="@dimen/drawer_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        tools:layout="@layout/fragment_main_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
