<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_white_rounded_12dp"
    android:elevation="0.5dp"
    android:padding="16dp"
    android:clickable="true"
    android:focusable="true">

    <!-- 2. 상태 태그 뱃지 -->
    <TextView
        android:id="@+id/tv_status_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="신규접수"
        tools:background="@drawable/bg_tag_light_green"
        tools:textColor="@color/green_accent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 3. 중복 표시 뱃지 (duplicateState == "Y" 인 경우 노출) -->
    <TextView
        android:id="@+id/tv_duplicate_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="중복"
        android:textColor="@color/red"
        android:background="@drawable/bg_badge_red_border"
        android:textSize="10sp"
        android:textStyle="bold"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        tools:visibility="visible"
        app:layout_constraintStart_toEndOf="@id/tv_status_tag"
        app:layout_constraintTop_toTopOf="@id/tv_status_tag"
        app:layout_constraintBottom_toBottomOf="@id/tv_status_tag" />

    <!-- 4. 웹사이트 명칭 표시 (출처) -->
    <TextView
        android:id="@+id/tv_website"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:textSize="11sp"
        android:textColor="@color/gray_text"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="end"
        tools:text="FlowDesk 공식사이트"
        app:layout_constraintEnd_toStartOf="@id/iv_more"
        app:layout_constraintStart_toEndOf="@id/tv_duplicate_tag"
        app:layout_constraintTop_toTopOf="@id/tv_status_tag"
        app:layout_constraintBottom_toBottomOf="@id/tv_status_tag" />

    <!-- 5. 우측 상단 더보기 옵션 버튼 -->
    <ImageView
        android:id="@+id/iv_more"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_more_vert"
        android:padding="2dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="@color/gray_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/tv_status_tag" />

    <!-- 6. 고객 이름 -->
    <TextView
        android:id="@+id/tv_customer_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#111827"
        tools:text="홍길동"
        app:layout_constraintStart_toStartOf="@id/tv_status_tag"
        app:layout_constraintTop_toBottomOf="@id/tv_status_tag" />

    <!-- 7. 전화번호 및 복사 버튼 -->
    <LinearLayout
        android:id="@+id/ll_phone_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="@id/tv_customer_name"
        app:layout_constraintTop_toBottomOf="@id/tv_customer_name">

        <TextView
            android:id="@+id/tv_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#4B5563"
            tools:text="010-1234-5678" />

        <ImageView
            android:id="@+id/btn_copy_phone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_copy"
            android:padding="2dp"
            android:layout_marginStart="6dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/gray_text" />
    </LinearLayout>

    <!-- 8. 담당자 지정 드롭다운 배지 (스피너 대용) -->
    <LinearLayout
        android:id="@+id/layout_employee"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_rect_rounded_light_gray"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_customer_name"
        app:layout_constraintBottom_toBottomOf="@id/ll_phone_container">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_user"
            app:tint="#4B5563" />

        <TextView
            android:id="@+id/tv_employee_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#374151"
            tools:text="김직원" />

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_arrow_drop_down"
            app:tint="#6B7280"
            android:layout_marginStart="2dp" />
    </LinearLayout>

    <!-- 9. 중간 구분선 -->
    <View
        android:id="@+id/v_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#E5E7EB"
        android:layout_marginTop="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_phone_container" />

    <!-- 10. 등록일 정보 -->
    <TextView
        android:id="@+id/tv_reg_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="11sp"
        android:textColor="@color/gray_text"
        tools:text="등록일: 2026-06-09 06:52"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_divider" />

    <!-- 11. 예약일 정보 (예약일시가 존재하는 경우만 노출 및 보라색 강조) -->
    <TextView
        android:id="@+id/tv_resv_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#7C3AED"
        tools:text="예약일: 2026-03-15 14:00"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_reg_date"
        app:layout_constraintBottom_toBottomOf="@id/tv_reg_date" />

    <!-- 12. 동적 추가 필드 데이터 영역 (주소, 나이 등 커스텀 필드 표시 레이아웃) -->
    <LinearLayout
        android:id="@+id/layout_custom_fields"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_reg_date">

        <!-- 예시 동적 텍스트 뱃지 1 (주소) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#F3F4F6"
            android:textColor="#4B5563"
            android:textSize="10sp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:layout_marginEnd="6dp"
            android:text="주소: 서울시 강남구" />

        <!-- 예시 동적 텍스트 뱃지 2 (나이) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#F3F4F6"
            android:textColor="#4B5563"
            android:textSize="10sp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="나이: 35세" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
