<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="5dp"
    android:background="@drawable/bg_white_rounded_12dp"
    android:padding="16dp"
    android:clickable="true"
    android:focusable="true">

        <!-- ─── 더보기 버튼 (우측 상단 끝 - 타이틀 기준 수직 중앙) ─── -->
        <ImageView
            android:id="@+id/btn_more"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/text_hint"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_web_title"
            app:layout_constraintBottom_toBottomOf="@id/tv_web_title" />

        <!-- ─── 상태 배지 (더보기 버튼 바로 왼쪽 - 타이틀 기준 수직 중앙) ─── -->
        <TextView
            android:id="@+id/tv_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="• 활성"
            android:textColor="@color/color_success_active"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@id/btn_more"
            app:layout_constraintTop_toTopOf="@id/tv_web_title"
            app:layout_constraintBottom_toBottomOf="@id/tv_web_title" />

        <!-- ─── 웹사이트 타이틀 ─── -->
        <TextView
            android:id="@+id/tv_web_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_strong"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tv_status_badge"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="예제 웹사이트" />

        <!-- ─── 웹사이트 코드 ─── -->
        <TextView
            android:id="@+id/tv_web_code"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="@color/text_hint"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tv_status_badge"
            app:layout_constraintTop_toBottomOf="@id/tv_web_title"
            tools:text="SITE001" />

        <!-- ─── 구분선 ─── -->
        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/bg_divider"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tv_web_code"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ─── URL 행 ─── -->
        <ImageView
            android:id="@+id/ic_url"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_share"
            app:tint="@color/text_tertiary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_web_url"
            app:layout_constraintBottom_toBottomOf="@id/tv_web_url" />

        <TextView
            android:id="@+id/tv_web_url"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="10dp"
            android:textSize="12sp"
            android:textColor="@color/login_blue"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/ic_url"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider"
            tools:text="https://example.com" />

        <!-- ─── 하단 메타 행: 담당자 · 중복허용일 ─── -->
        <LinearLayout
            android:id="@+id/ll_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tv_web_url"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- 담당자 -->
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_user"
                app:tint="@color/text_tertiary"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tv_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/text_tertiary"
                tools:text="홍길동" />

            <!-- 점 구분 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" · "
                android:textColor="@color/text_disabled"
                android:textSize="12sp" />

            <!-- 중복 허용일 -->
            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_calendar"
                app:tint="@color/text_tertiary"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tv_duplicate_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/text_tertiary"
                tools:text="중복 허용 30일" />

        </LinearLayout>

        <!-- ─── 히든 메뉴 (더보기 클릭 시 확장되는 텍스트 메뉴) ─── -->
        <LinearLayout
            android:id="@+id/ll_hidden_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/ll_meta"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- 상태 변경 버튼 -->
            <TextView
                android:id="@+id/btn_toggle_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="비활성화"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />

            <!-- 세로 구분선 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="|"
                android:textColor="#D1D5DB"
                android:textSize="11sp"
                android:layout_gravity="center_vertical" />

            <!-- 삭제 버튼 -->
            <TextView
                android:id="@+id/btn_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="삭제"
                android:textColor="@color/color_error"
                android:textSize="13sp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
