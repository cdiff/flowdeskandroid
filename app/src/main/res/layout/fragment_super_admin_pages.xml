<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F4F6">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ─── Summary Card ─── -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_white_rounded_12dp"
                android:elevation="2dp"
                android:layout_marginBottom="16dp"
                android:padding="20dp"
                android:layout_marginHorizontal="2dp"
                android:layout_marginTop="2dp">

                <ImageView
                    android:id="@+id/iv_pages_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    android:background="@drawable/bg_card_rounded_border"
                    android:padding="12dp"
                    app:tint="@color/login_blue"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_total_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="전체 페이지"
                    android:textColor="@color/gray_text"
                    android:textSize="12sp"
                    android:layout_marginStart="16dp"
                    app:layout_constraintStart_toEndOf="@id/iv_pages_icon"
                    app:layout_constraintTop_toTopOf="@id/iv_pages_icon" />

                <TextView
                    android:id="@+id/tv_total_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="22개"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@id/tv_total_title"
                    app:layout_constraintTop_toBottomOf="@id/tv_total_title" />

                <!-- 활성 / 비활성 통계 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card_rounded_border"
                    android:paddingVertical="12dp"
                    android:baselineAligned="false"
                    app:layout_constraintTop_toBottomOf="@id/iv_pages_icon">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="활성 페이지"
                            android:textColor="@color/gray_text"
                            android:textSize="12sp"
                            android:layout_marginBottom="4dp"/>
                        <TextView
                            android:id="@+id/tv_active_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="20"
                            android:textColor="@color/green_accent"
                            android:textSize="16sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#E5E5E5"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="비활성 페이지"
                            android:textColor="@color/gray_text"
                            android:textSize="12sp"
                            android:layout_marginBottom="4dp"/>
                        <TextView
                            android:id="@+id/tv_inactive_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="2"
                            android:textColor="@color/red"
                            android:textSize="16sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ─── Create Page Banner ─── -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btn_create_page"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_rect_rounded_blue"
                android:padding="20dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_create_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_input_add"
                    android:background="@drawable/bg_banner_light_blue"
                    android:padding="12dp"
                    app:tint="@color/login_blue"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/tv_create_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="새 페이지 생성하기"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginStart="16dp"
                    app:layout_constraintStart_toEndOf="@id/iv_create_icon"
                    app:layout_constraintTop_toTopOf="@id/iv_create_icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="시스템 메뉴 구조에 새 페이지를 등록하세요"
                    android:textColor="#D0E3FF"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="@id/tv_create_title"
                    app:layout_constraintTop_toBottomOf="@id/tv_create_title" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/white"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ─── Search Bar ─── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded_border"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="@color/gray_text"
                    android:layout_marginEnd="8dp"/>

                <EditText
                    android:id="@+id/et_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="페이지명 / 경로 / 표시이름 검색..."
                    android:textColorHint="@color/gray_text"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:maxLines="1"
                    android:inputType="text"/>
            </LinearLayout>

            <!-- ─── Page List Card ─── -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded_border"
                android:paddingTop="20dp"
                android:paddingBottom="8dp"
                android:layout_marginBottom="24dp">

                <!-- 헤더 -->
                <TextView
                    android:id="@+id/tv_list_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="페이지 목록"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginStart="20dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <!-- 뱃지 행 (총 / 활성 / 비활성) -->
                <LinearLayout
                    android:id="@+id/ll_badges"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="10dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_list_title">

                    <TextView
                        android:id="@+id/tv_badge_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="총 22개"
                        android:textColor="@color/gray_text"
                        android:textSize="12sp"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:id="@+id/tv_badge_active"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="활성 20개"
                        android:textColor="@color/green_accent"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:id="@+id/tv_badge_inactive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="비활성 2개"
                        android:textColor="@color/red"
                        android:textSize="12sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <View
                    android:id="@+id/divider_list"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E5E5E5"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/ll_badges"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_pages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/divider_list"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="4"
                    tools:listitem="@layout/item_super_admin_page"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/divider_list"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_margin="32dp"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
