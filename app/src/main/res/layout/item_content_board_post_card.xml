<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="5dp"
    android:background="@drawable/bg_card_rounded_border"
    android:padding="16dp"
    android:clickable="true"
    android:focusable="true">


    <!-- 게시판 구분 뱃지 (각 게시판별 텍스트 및 색상 매핑) -->
    <TextView
        android:id="@+id/tv_notice_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="공지사항"
        android:textColor="@color/white"
        android:textSize="10sp"
        android:textStyle="bold"
        android:background="@drawable/bg_rect_rounded_red"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_post_title"
        app:layout_constraintBottom_toBottomOf="@id/tv_post_title"
        tools:visibility="visible" />

    <!-- 게시글 제목 -->
    <TextView
        android:id="@+id/tv_post_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/text_strong"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toEndOf="@id/tv_notice_badge"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="3월 전사 공지사항 안내 드립니다." />

    <!-- 작성자 및 작성일 정보 -->
    <TextView
        android:id="@+id/tv_post_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="12sp"
        android:textColor="@color/text_tertiary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_post_title"
        tools:text="작성자: 관리자(ID: 1)   /   2026. 03. 01." />

</androidx.constraintlayout.widget.ConstraintLayout>
