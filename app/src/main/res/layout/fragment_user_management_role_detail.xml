<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9">

    <!-- 상단 헤더 툴바 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_chevron_left"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@android:color/transparent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="역할 상세"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 로딩 ProgressBar (데이터 로드 전 노출) -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 스크롤 콘텐츠 (데이터 로드 후 VISIBLE) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="invisible"
        tools:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fillViewport="true">

        <!-- 부모 배경을 회색으로 설정 → 섹션 사이 마진에서 자연스럽게 배경색 노출 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F1F5F9">

            <!-- ① 역할 기본 정보 섹션 (마이페이지 프로필 스타일 - 하단 모서리 둥글게) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_white_bottom_rounded_8dp"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="20dp">

                <!-- 프로필 영역: 클릭 이벤트 영역 -->
                <LinearLayout
                    android:id="@+id/cl_display_name_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="8dp"
                    android:layout_marginBottom="15dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@android:color/transparent">

                    <!-- 배지 가로 배치 영역 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <!-- 상태 배지 (ADMIN 스타일: border + 작은 텍스트) -->
                        <TextView
                            android:id="@+id/tv_role_status"
                            android:layout_width="wrap_content"
                            android:layout_height="20dp"
                            tools:text="활성"
                            android:textSize="10sp"
                            android:textColor="@color/color_success_active"
                            android:background="@drawable/bg_badge_rounded_green_border"
                            android:paddingHorizontal="8dp"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:layout_marginEnd="6dp" />

                        <!-- 시스템 역할 코드 배지 -->
                        <TextView
                            android:id="@+id/tv_role_code_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="20dp"
                            tools:text="super_admin"
                            android:textSize="10sp"
                            android:textColor="@color/login_blue"
                            android:background="@drawable/bg_badge_rounded_blue_border"
                            android:paddingHorizontal="8dp"
                            android:gravity="center"
                            android:includeFontPadding="false" />

                    </LinearLayout>

                    <!-- 이름 + > 화살표 영역 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">

                        <!-- 역할 표시 이름 (크게) -->
                        <TextView
                            android:id="@+id/tv_role_display_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="슈퍼 관리자"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#0F172A" />

                        <!-- 수정 유도 > 아이콘 (이름 바로 옆에 배치, 이름과 동일한 색상) -->
                        <ImageView
                            android:id="@+id/iv_edit_arrow"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#0F172A"
                            android:layout_marginStart="4dp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- 설명 소제목 추가 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="설명"
                    android:textSize="12sp"
                    android:textColor="#94A3B8"
                    android:layout_marginBottom="8dp" />

                <!-- bg_edit_text 스타일의 텍스트뷰 (역할명 아래 배치) -->
                <TextView
                    android:id="@+id/tv_role_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_edit_text"
                    android:padding="12dp"
                    android:minLines="4"
                    android:gravity="top|start"
                    tools:text="시스템 전체 관리 권한을 가진 최고 관리자입니다. 이 역할은 모든 메뉴와 리소스에 자유롭게 접근할 수 있습니다."
                    android:textSize="14sp"
                    android:textColor="#0F172A"
                    android:lineSpacingExtra="4dp" />

            </LinearLayout>

            <!-- 1.5 역할 복사 영역 (카드 안의 카드 중복 제거 - 투명 배경에 아이템만 카드형) -->
            <LinearLayout
                android:id="@+id/ll_copy_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="16dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- 섹션 제목 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="다른 역할의 권한 복사하기"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:layout_marginStart="20dp"
                    android:layout_marginBottom="6dp" />

                <!-- 가로 뷰페이저 (클리핑 비활성화로 좌우 카드 피크 효과) -->
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vp_role_templates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:clipChildren="false"
                    android:paddingHorizontal="64dp"
                    tools:layout_height="150dp"
                    tools:orientation="horizontal"
                    tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_role_copy_card" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_white_rounded_12dp"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:layout_marginBottom="8dp">

                <!-- 섹션 제목 -->
                <TextView
                    android:id="@+id/tv_perm_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="세부 권한 (17개)"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:layout_marginBottom="20dp" />

                <!-- 세부 권한 타이틀 하단 구분선 (부모 패딩 적용으로 원래 간격 복원) -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/slate_300"
                    android:layout_marginBottom="8dp" />

                <!-- 권한 목록 컨테이너 -->
                <LinearLayout
                    android:id="@+id/ll_permissions_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 안드로이드 스튜디오 미리보기용 더미 아이템 -->
                    <include layout="@layout/item_role_detail_page" />
                    <include layout="@layout/item_role_detail_page" />

                </LinearLayout>

            </LinearLayout>

            <!-- ③ 할당된 팀원 섹션 (상단 모서리만 둥글게) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_white_top_rounded_8dp"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="16dp">

                <!-- 섹션 제목 -->
                <TextView
                    android:id="@+id/tv_users_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="할당된 팀원 (3명)"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:layout_marginBottom="20dp" />

                <!-- 할당된 팀원 타이틀 하단 구분선 (부모 패딩 적용으로 원래 간격 복원) -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/slate_300"
                    android:layout_marginBottom="12dp" />

                <!-- 팀원 목록 컨테이너 -->
                <LinearLayout
                    android:id="@+id/ll_users_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 안드로이드 스튜디오 미리보기용 더미 아이템 -->
                    <include layout="@layout/item_role_assigned_user" />
                    <include layout="@layout/item_role_assigned_user" />

                </LinearLayout>

            </LinearLayout>

            <!-- 하단 여백 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="24dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
