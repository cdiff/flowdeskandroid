<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingTop="16dp">

    <!-- Handle line at top -->
    <View
        android:id="@+id/handle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#E5E5E5"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/btn_close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_close"
        app:tint="@color/gray_text"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_header_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_user_add"
        android:background="@drawable/bg_rect_rounded_blue"
        android:padding="12dp"
        app:tint="@color/white"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/handle" />

    <TextView
        android:id="@+id/tv_header_title"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:text="새 팀원 초대"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/iv_header_icon"
        app:layout_constraintTop_toTopOf="@id/iv_header_icon" />

    <TextView
        android:id="@+id/tv_header_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="팀을 성장시키세요"
        android:textColor="@color/gray_text"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@id/tv_header_title"
        app:layout_constraintTop_toBottomOf="@id/tv_header_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/iv_header_icon"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="20dp">

            <!-- Section 1: 계정 정보 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_user"
                    android:background="@drawable/bg_oval_light_blue"
                    android:padding="8dp"
                    app:tint="@color/login_blue" />
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="계정 정보"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="사용자 ID *"
                android:textColor="@color/gray_text"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />
            
            <EditText
                android:id="@+id/et_user_id"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_card_rounded_border"
                android:hint="john.doe"
                android:paddingHorizontal="16dp"
                android:drawablePadding="12dp"
                android:drawableTint="@color/gray_text"
                android:maxLines="1"
                android:inputType="text"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="비밀번호 *"
                android:textColor="@color/gray_text"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_card_rounded_border"
                android:hint="6자 이상 입력"
                android:paddingHorizontal="16dp"
                android:drawableStart="@drawable/ic_lock"
                android:drawablePadding="12dp"
                android:drawableTint="@color/gray_text"
                android:maxLines="1"
                android:inputType="textPassword"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="비밀번호 확인 *"
                android:textColor="@color/gray_text"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_password_confirm"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_card_rounded_border"
                android:hint="비밀번호 재입력"
                android:paddingHorizontal="16dp"
                android:drawableStart="@drawable/ic_lock"
                android:drawablePadding="12dp"
                android:drawableTint="@color/gray_text"
                android:maxLines="1"
                android:inputType="textPassword"
                android:textSize="14sp"
                android:layout_marginBottom="24dp" />

            <!-- Divider: 기본 정보 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="#E5E5E5" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="기본 정보" android:textColor="@color/gray_text" android:textSize="12sp" android:layout_marginHorizontal="16dp" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="#E5E5E5" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이름 *"
                android:textColor="@color/gray_text"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />
            
            <EditText
                android:id="@+id/et_user_name"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_card_rounded_border"
                android:hint="홍길동"
                android:paddingHorizontal="16dp"
                android:maxLines="1"
                android:inputType="text"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이메일 *"
                android:textColor="@color/gray_text"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />
            
            <EditText
                android:id="@+id/et_user_email"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_card_rounded_border"
                android:hint="user@example.com"
                android:drawableStart="@drawable/ic_email"
                android:paddingHorizontal="16dp"
                android:drawablePadding="12dp"
                android:drawableTint="@color/gray_text"
                android:maxLines="1"
                android:inputType="textEmailAddress"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="전화번호"
                        android:textColor="@color/gray_text"
                        android:textSize="12sp"
                        android:layout_marginBottom="8dp" />
                    
                    <EditText
                        android:id="@+id/et_user_tel"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_card_rounded_border"
                        android:hint="02-1234-5678"
                        android:paddingHorizontal="16dp"
                        android:maxLines="1"
                        android:inputType="phone"
                        android:textSize="14sp"
                        />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="휴대폰"
                        android:textColor="@color/gray_text"
                        android:textSize="12sp"
                        android:layout_marginBottom="8dp" />
                    
                    <EditText
                        android:id="@+id/et_user_hp"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_card_rounded_border"
                        android:hint="010-1234-5678"
                        android:paddingHorizontal="16dp"
                        android:maxLines="1"
                        android:inputType="phone"
                        android:textSize="14sp"
                        />
                </LinearLayout>

            </LinearLayout>

            <!-- Divider: 역할 선택 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="#E5E5E5" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="역할 선택" android:textColor="@color/gray_text" android:textSize="12sp" android:layout_marginHorizontal="16dp" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="#E5E5E5" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_person_permission"
                    android:background="@drawable/bg_oval_light_blue"
                    android:padding="8dp"
                    app:tint="@color/login_blue" />
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="권한 설정"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <!-- Roles Grid 2x2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="16dp">

                <!-- Admin -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_role_admin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_rounded_border"
                    android:padding="16dp"
                    android:layout_marginEnd="8dp">
                    
                    <ImageView 
                        android:id="@+id/iv_admin"
                        android:layout_width="36dp" 
                        android:layout_height="36dp" 
                        android:src="@drawable/ic_super_admin"
                        android:background="@drawable/bg_icon_gray" 
                        app:tint="#8BA1B8"
                        android:padding="8dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>
                        
                    <ImageView
                        android:id="@+id/iv_admin_radio"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_radio_unselected"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView 
                        android:id="@+id/tv_admin"
                        android:layout_width="wrap_content" 
                        android:layout_height="wrap_content" 
                        android:text="관리자" 
                        android:textStyle="bold" 
                        android:textColor="#3A485A" 
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@id/iv_admin"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView 
                        android:id="@+id/tv_admin_desc"
                        android:layout_width="wrap_content" 
                        android:layout_height="wrap_content" 
                        android:text="전체 관리" 
                        android:textColor="@color/gray_text" 
                        android:textSize="12sp" 
                        android:layout_marginTop="4dp"
                        app:layout_constraintTop_toBottomOf="@id/tv_admin"
                        app:layout_constraintStart_toStartOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Manager -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_role_manager"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_rounded_border"
                    android:padding="16dp"
                    android:layout_marginStart="8dp">

                    <ImageView 
                        android:id="@+id/iv_manager"
                        android:layout_width="36dp" 
                        android:layout_height="36dp" 
                        android:src="@drawable/ic_users" 
                        android:background="@drawable/bg_icon_gray" 
                        app:tint="#8BA1B8"
                        android:padding="8dp" 
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <ImageView
                        android:id="@+id/iv_manager_radio"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_radio_unselected"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView 
                        android:id="@+id/tv_manager"
                        android:layout_width="wrap_content" 
                        android:layout_height="wrap_content" 
                        android:text="매니저" 
                        android:textStyle="bold" 
                        android:textColor="#3A485A" 
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@id/iv_manager"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView 
                        android:id="@+id/tv_manager_desc"
                        android:layout_width="wrap_content" 
                        android:layout_height="wrap_content" 
                        android:text="팀 관리" 
                        android:textColor="@color/gray_text" 
                        android:textSize="12sp" 
                        android:layout_marginTop="4dp"
                        app:layout_constraintTop_toBottomOf="@id/tv_manager"
                        app:layout_constraintStart_toStartOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="24dp">

                <!-- Member (Selected) -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_role_member"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_rounded_border"
                    android:padding="16dp"
                    android:layout_marginEnd="8dp">

                    <ImageView
                        android:id="@+id/iv_member"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_icon_gray"
                        android:padding="8dp"
                        android:src="@drawable/ic_users"
                        app:tint="#8BA1B8" 
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <ImageView
                        android:id="@+id/iv_member_radio"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_radio_unselected"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView 
                        android:id="@+id/tv_member"
                        android:layout_width="wrap_content" 
                        android:layout_height="wrap_content" 
                        android:text="팀원" 
                        android:textStyle="bold" 
                        android:textColor="#3A485A" 
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@id/iv_member"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView 
                        android:id="@+id/tv_member_desc"
                        android:layout_width="wrap_content" 
                        android:layout_height="wrap_content" 
                        android:text="일반 업무" 
                        android:textColor="@color/gray_text" 
                        android:textSize="12sp" 
                        android:layout_marginTop="4dp"
                        app:layout_constraintTop_toBottomOf="@id/tv_member"
                        app:layout_constraintStart_toStartOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Guest -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_role_guest"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_rounded_border"
                    android:padding="16dp"
                    android:layout_marginStart="8dp">

                    <ImageView 
                        android:id="@+id/iv_guest"
                        android:layout_width="36dp" 
                        android:layout_height="36dp" 
                        android:src="@drawable/ic_visibility_on" 
                        android:background="@drawable/bg_icon_gray" 
                        app:tint="#8BA1B8"
                        android:padding="8dp" 
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <ImageView
                        android:id="@+id/iv_guest_radio"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_radio_unselected"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView 
                        android:id="@+id/tv_guest"
                        android:layout_width="wrap_content" 
                        android:layout_height="wrap_content" 
                        android:text="게스트" 
                        android:textStyle="bold" 
                        android:textColor="#3A485A" 
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@id/iv_guest"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView 
                        android:id="@+id/tv_guest_desc"
                        android:layout_width="wrap_content" 
                        android:layout_height="wrap_content" 
                        android:text="읽기 전용" 
                        android:textColor="@color/gray_text" 
                        android:textSize="12sp" 
                        android:layout_marginTop="4dp"
                        app:layout_constraintTop_toBottomOf="@id/tv_guest"
                        app:layout_constraintStart_toStartOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_selected_role"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:background="@drawable/bg_oval_light_blue"
                android:paddingHorizontal="16dp"
                android:text="선택된 역할: 팀원"
                android:textColor="@color/login_blue"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginBottom="24dp" />

            <!-- Loading Indicator Container -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">
                <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_gravity="center" />
                <TextView
                    android:id="@+id/tv_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/red"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:visibility="gone" />
            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:background="@color/white"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="취소"
            android:textColor="@color/black"
            android:background="@drawable/bg_card_rounded_border"
            android:layout_marginEnd="8dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_invite"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="초대하기"
            android:textColor="@color/white"
            android:background="@drawable/bg_rect_rounded_blue"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
