<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 선택됨 -->
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/bg_card_selected"/>
            <corners android:radius="16dp"/>
            <stroke
                android:width="1dp"
                android:color="@color/brand_primary"/>
        </shape>
    </item>

    <!-- 기본 -->
    <item>
        <shape>
            <solid android:color="@color/bg_card_unselected"/>
            <corners android:radius="16dp"/>
            <stroke
                android:width="1dp"
                android:color="@color/tab_unselected_stroke"/>
        </shape>
    </item>

</selector>