<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Checked (ON) -->
    <item android:state_checked="true">
        <layer-list>
            <item
                android:gravity="center"
                android:width="48dp"
                android:height="28dp">
                <shape android:shape="rectangle">
                    <solid android:color="#34C759" />
                    <corners android:radius="14dp" />
                    <size android:width="48dp" android:height="28dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Unchecked (OFF) -->
    <item>
        <layer-list>
            <item
                android:gravity="center"
                android:width="48dp"
                android:height="28dp">
                <shape android:shape="rectangle">
                    <solid android:color="#E9E9EB" />
                    <corners android:radius="14dp" />
                    <size android:width="48dp" android:height="28dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
