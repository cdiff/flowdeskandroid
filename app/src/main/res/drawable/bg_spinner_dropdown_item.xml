<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. 기본 흰색 배경 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
        </shape>
    </item>
    
    <!-- 2. 하단 1dp 옅은 회색 선 (좌우상단을 음수 마진으로 깎아 하단만 보이게 처리) -->
    <item
        android:left="-2dp"
        android:right="-2dp"
        android:top="-2dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#F1F5F9" />
        </shape>
    </item>
</layer-list>
