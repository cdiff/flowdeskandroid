<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_main"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.flowdesk_android.presentation.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/myPageFragment"
        android:name="com.example.flowdesk_android.presentation.ui.mypage.MyPageFragment"
        android:label="MyPage"
        tools:layout="@layout/fragment_mypage" />

    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.example.flowdesk_android.presentation.ui.mypage.EditProfileFragment"
        android:label="EditProfile"
        tools:layout="@layout/fragment_edit_profile" />

    <fragment
        android:id="@+id/changePasswordFragment"
        android:name="com.example.flowdesk_android.presentation.ui.mypage.ChangePasswordFragment"
        android:label="ChangePassword"
        tools:layout="@layout/fragment_change_password" />
    <fragment
        android:id="@+id/usersFragment"
        android:name="com.example.flowdesk_android.presentation.ui.common.DynamicTabHostFragment"
        android:label="Users"
        tools:layout="@layout/fragment_dynamic_tab_host" />

    <fragment
        android:id="@+id/userDetailFragment"
        android:name="com.example.flowdesk_android.presentation.ui.users.UserDetailFragment"
        android:label="UserDetail"
        tools:layout="@layout/fragment_user_detail" />

    <fragment
        android:id="@+id/rolesFragment"
        android:name="com.example.flowdesk_android.presentation.ui.roles.RolesFragment"
        android:label="Roles"
        tools:layout="@layout/fragment_roles" />

    <fragment
        android:id="@+id/roleDetailFragment"
        android:name="com.example.flowdesk_android.presentation.ui.roles.RoleDetailFragment"
        android:label="RoleDetail"
        tools:layout="@layout/fragment_role_detail">
        <argument
            android:name="roleId"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/managePermissionsFragment"
        android:name="com.example.flowdesk_android.presentation.ui.roles.ManagePermissionsFragment"
        android:label="ManagePermissions"
        tools:layout="@layout/fragment_manage_permissions">
        <argument
            android:name="role_id"
            app:argType="integer" />
    </fragment>
</navigation>
