<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_main"
    app:startDestination="@id/usersFragment">

    <fragment
        android:id="@+id/myPageFragment"
        android:name="com.example.flowdesk_android.feature.mypage.presentation.main.MyPageFragment"
        android:label="MyPage"
        tools:layout="@layout/fragment_mypage_main" />

    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.example.flowdesk_android.feature.mypage.presentation.edit_profile.EditProfileFragment"
        android:label="프로필 수정"
        tools:layout="@layout/fragment_mypage_edit_profile" />

    <fragment
        android:id="@+id/changePasswordFragment"
        android:name="com.example.flowdesk_android.feature.mypage.presentation.change_password.ChangePasswordFragment"
        android:label="비밀번호 변경"
        tools:layout="@layout/fragment_mypage_change_password" />

    <fragment
        android:id="@+id/usersFragment"
        android:name="com.example.flowdesk_android.feature.main.common.DynamicTabHostFragment"
        android:label="Users"
        tools:layout="@layout/fragment_main_dynamic_tab_host" />

    <fragment
        android:id="@+id/userDetailFragment"
        android:name="com.example.flowdesk_android.feature.user_management.presentation.users.detail.UserDetailFragment"
        android:label="사용자 상세 정보"
        tools:layout="@layout/fragment_user_management_user_detail" />

    <fragment
        android:id="@+id/rolesFragment"
        android:name="com.example.flowdesk_android.feature.user_management.presentation.roles.list.RolesFragment"
        android:label="Roles"
        tools:layout="@layout/fragment_user_management_role_list" />

    <fragment
        android:id="@+id/roleDetailFragment"
        android:name="com.example.flowdesk_android.feature.user_management.presentation.roles.detail.RoleDetailFragment"
        android:label="역할 상세 정보"
        tools:layout="@layout/fragment_user_management_role_detail">
        <argument
            android:name="roleId"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/tenantDetailFragment"
        android:name="com.example.flowdesk_android.feature.super_admin.presentation.tenants.TenantDetailFragment"
        android:label="테넌트 상세 정보"
        tools:layout="@layout/fragment_super_admin_tenant_detail">
        <argument
            android:name="tenant_id"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/managePermissionsFragment"
        android:name="com.example.flowdesk_android.feature.user_management.presentation.roles.permissions.ManagePermissionsFragment"
        android:label="권한 관리"
        tools:layout="@layout/fragment_user_management_role_manage_permissions">
        <argument
            android:name="role_id"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/superAdminActionsFragment"
        android:name="com.example.flowdesk_android.feature.super_admin.presentation.actions.SuperAdminActionsFragment"
        android:label="Actions"
        tools:layout="@layout/fragment_super_admin_actions" />

    <fragment
        android:id="@+id/counselDashboardFragment"
        android:name="com.example.flowdesk_android.feature.counsel_management.presentation.dashboard.CounselDashboardFragment"
        android:label="CounselDashboard"
        tools:layout="@layout/fragment_counsel_dashboard" />

    <fragment
        android:id="@+id/counselDetailFragment"
        android:name="com.example.flowdesk_android.feature.counsel_management.presentation.detail.CounselDetailFragment"
        android:label="상담 상세 정보"
        tools:layout="@layout/fragment_counsel_detail">
        <argument
            android:name="counselSeq"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/statusEditFragment"
        android:name="com.example.flowdesk_android.feature.system_management.presentation.status.StatusEditFragment"
        android:label="상태 상세 정보"
        tools:layout="@layout/fragment_status_edit">
        <argument
            android:name="tenantStatusId"
            app:argType="long"
            android:defaultValue="-1L" />
        <argument
            android:name="defaultGroup"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <fragment
        android:id="@+id/blockIpDetailFragment"
        android:name="com.example.flowdesk_android.feature.system_management.presentation.block.ip.BlockIpDetailFragment"
        android:label="IP 차단 상세 정보"
        tools:layout="@layout/fragment_block_ip_detail">
        <argument
            android:name="blockIpId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/blockPhoneDetailFragment"
        android:name="com.example.flowdesk_android.feature.system_management.presentation.block.phone.BlockPhoneDetailFragment"
        android:label="전화번호 차단 상세 정보"
        tools:layout="@layout/fragment_block_phone_detail">
        <argument
            android:name="blockHpId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/blockKeywordDetailFragment"
        android:name="com.example.flowdesk_android.feature.system_management.presentation.block.keyword.BlockKeywordDetailFragment"
        android:label="금칙어 차단 상세 정보"
        tools:layout="@layout/fragment_block_keyword_detail">
        <argument
            android:name="blockWordId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/inviteTeamFragment"
        android:name="com.example.flowdesk_android.feature.user_management.presentation.users.invite.InviteTeamFragment"
        android:label="팀원 초대"
        tools:layout="@layout/fragment_user_management_user_invite">
        <action
            android:id="@+id/action_inviteTeamFragment_to_invitePasswordFragment"
            app:destination="@id/invitePasswordFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/invitePasswordFragment"
        android:name="com.example.flowdesk_android.feature.user_management.presentation.users.invite.InvitePasswordFragment"
        android:label="비밀번호 설정"
        tools:layout="@layout/fragment_invite_password">
        <action
            android:id="@+id/action_invitePasswordFragment_to_inviteRoleFragment"
            app:destination="@id/inviteRoleFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/inviteRoleFragment"
        android:name="com.example.flowdesk_android.feature.user_management.presentation.users.invite.InviteRoleFragment"
        android:label="역할 설정"
        tools:layout="@layout/fragment_invite_role" />

    <fragment
        android:id="@+id/websiteListFragment"
        android:name="com.example.flowdesk_android.feature.system_management.presentation.website.WebsiteListFragment"
        android:label="WebsiteList"
        tools:layout="@layout/fragment_system_website_list" />

    <fragment
        android:id="@+id/websiteDetailFragment"
        android:name="com.example.flowdesk_android.feature.system_management.presentation.website.WebsiteDetailFragment"
        android:label="웹사이트 상세 정보"
        tools:layout="@layout/fragment_system_website_detail">
        <argument
            android:name="webCode"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/websiteCreateFragment"
        android:name="com.example.flowdesk_android.feature.system_management.presentation.website.WebsiteCreateFragment"
        android:label="웹사이트 등록"
        tools:layout="@layout/fragment_system_website_create" />

    <!-- 게시판 타입 관리 -->
    <fragment
        android:id="@+id/boardTypeListFragment"
        android:name="com.example.flowdesk_android.feature.system_management.presentation.board_type.BoardTypeListFragment"
        android:label="BoardTypeList"
        tools:layout="@layout/fragment_system_board_type_list" />

    <fragment
        android:id="@+id/boardTypeDetailFragment"
        android:name="com.example.flowdesk_android.feature.system_management.presentation.board_type.BoardTypeDetailFragment"
        android:label="게시판 타입 상세"
        tools:layout="@layout/fragment_system_board_type_detail">
        <argument
            android:name="boardId"
            app:argType="long" />
    </fragment>

    <!-- 게시글 관리 -->
    <fragment
        android:id="@+id/boardPostListFragment"
        android:name="com.example.flowdesk_android.feature.content_management.presentation.board_post.BoardPostListFragment"
        android:label="BoardPostList"
        tools:layout="@layout/fragment_content_board_post_list" />

    <fragment
        android:id="@+id/boardPostDetailFragment"
        android:name="com.example.flowdesk_android.feature.content_management.presentation.board_post.BoardPostDetailFragment"
        android:label="게시글 수정"
        tools:layout="@layout/fragment_content_board_post_detail">
        <argument
            android:name="boardId"
            app:argType="long" />
        <argument
            android:name="postId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/boardPostReadFragment"
        android:name="com.example.flowdesk_android.feature.content_management.presentation.board_post.BoardPostReadFragment"
        android:label="게시글 상세"
        tools:layout="@layout/fragment_content_board_post_read">
        <argument
            android:name="boardId"
            app:argType="long" />
        <argument
            android:name="postId"
            app:argType="long" />
    </fragment>

</navigation>
