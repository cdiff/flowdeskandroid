<!-- Base application theme. -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Flowdeskandroid" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/login_blue</item>
        <item name="colorPrimaryVariant">@color/login_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Android 15(API 35+): statusBarColor, windowLightStatusBar deprecated.
             enableEdgeToEdge() + WindowInsetsControllerCompat으로 일원화 -->
    </style>
</resources>

